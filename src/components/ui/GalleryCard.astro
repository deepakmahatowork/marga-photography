---
// src/components/ui/GalleryCard.astro
// Reference UI Kit Component for Marga Photography

interface Props {
  imageSrc: string;
  imageAlt: string;
  title: string;
  location: string;
  iso?: string;
  aperture?: string;
}

const { 
  imageSrc, 
  imageAlt, 
  title, 
  location, 
  iso = "ISO 400", 
  aperture = "f/2.8" 
} = Astro.props;
---

<article class="tilt-card group relative w-full aspect-[4/5] overflow-hidden rounded-sm bg-obsidian-900 border border-alabaster-border cursor-pointer" data-tilt>
  <div class="tilt-card-inner absolute inset-0">
    <div class="tilt-glare" aria-hidden="true"></div>

  <!-- Image Layer: No flat opaque overlays -->
  <img 
    src={imageSrc} 
    alt={imageAlt}
    class="absolute inset-0 w-full h-full object-cover transition-transform duration-[1.2s] ease-[cubic-bezier(0.16,1,0.3,1)] group-hover:scale-105"
  />

  <!-- Gradient Scrim: Strict 2-stop directional mask ensuring pristine sky/snow -->
  <div class="absolute inset-0 pointer-events-none" style="background: var(--overlay-cinematic);"></div>

  <!-- Interactive Content Layer -->
  <div class="absolute inset-0 p-6 sm:p-8 flex flex-col justify-between z-10 pointer-events-none">
    
    <!-- Top Metadata: Technical Mono -->
    <div class="flex justify-between items-start opacity-0 translate-y-[-10px] group-hover:opacity-100 group-hover:translate-y-0 transition-all duration-500 ease-out">
      <span class="font-mono text-[11px] uppercase tracking-[0.08em] text-alabaster-500 bg-obsidian-800/80 backdrop-blur-sm px-2 py-1 rounded-sm border border-alabaster-border">
        {iso} · {aperture}
      </span>
      <span class="w-1.5 h-1.5 rounded-full bg-ochre-base shadow-[0_0_8px_rgba(200,90,50,0.6)] animate-pulse"></span>
    </div>

    <!-- Bottom Narrative: Editorial Heading -->
    <div class="transform translate-y-4 group-hover:translate-y-0 transition-transform duration-700 ease-[cubic-bezier(0.16,1,0.3,1)]">
      <h3 class="font-display text-2xl sm:text-3xl text-alabaster-900 leading-tight mb-2">
        {title}
      </h3>
      <div class="h-0 overflow-hidden group-hover:h-auto transition-all duration-700 opacity-0 group-hover:opacity-100">
        <p class="font-sans text-xs text-alabaster-500 tracking-[0.08em] mt-3 uppercase">
          {location}
        </p>
      </div>
    </div>
  </div>
  </div>
</article>
