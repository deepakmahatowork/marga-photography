---
interface Expedition {
  id: string;
  data: {
    title: string;
    tagline: string;
    heroImage: string;
    category: string;
    region: string;
    durationDays: number;
    groupSize: string;
    photographyLevel: string;
    difficulty: string;
    bestSeason: string;
    priceFrom: string;
    highlights: string[];
  };
}

interface Props {
  expedition: Expedition;
}

const { expedition } = Astro.props;
const exp  = expedition.data;
const slug = expedition.id.replace(/\.(md|mdx|json)$/, '');
---

<!-- ╔══════════════════════════════════════════════════════════
     EXPEDITION CARD — Editorial sharp-edge card
     Sharp corners · Gold bottom border reveal on hover
     Vertical category strip · Film-counter styling
     ══════════════════════════════════════════════════════════ -->

<article class="expedition-editorial-card group relative flex flex-col bg-canvas-surface overflow-hidden border border-canvas-border hover:border-accent-himalaya/40 transition-all duration-500 rounded-none shadow-xs hover:shadow-xl">

  <!-- Image container -->
  <a href={`/expeditions/${slug}`} class="block relative aspect-[16/10] overflow-hidden editorial-img-frame" tabindex="-1" aria-hidden="true">
    <img
      src={exp.heroImage}
      alt={exp.title}
      loading="lazy"
      decoding="async"
      class="w-full h-full object-cover brightness-[0.92]"
    />

    <!-- Gradient overlay -->
    <div class="absolute inset-0 bg-gradient-to-t from-black/75 via-black/10 to-transparent"></div>

    <!-- Vertical category strip — left edge -->
    <div class="absolute top-0 left-0 bottom-0 w-8 flex items-center justify-center bg-black/60 border-r border-white/10">
      <span class="journal-label text-[0.48rem] text-white/70 tracking-[0.3em] uppercase" style="writing-mode: vertical-rl; text-orientation: mixed; transform: rotate(180deg)">
        {exp.category}
      </span>
    </div>

    <!-- Duration + group — bottom overlay on photo -->
    <div class="absolute bottom-0 left-8 right-0 px-4 pb-3 flex items-center justify-between">
      <span class="font-sans text-[0.62rem] tracking-[0.2em] uppercase text-white/80 font-light">
        {exp.durationDays} days
      </span>
      <span class="font-sans text-[0.62rem] tracking-[0.2em] uppercase text-white/70 font-light">
        {exp.groupSize}
      </span>
    </div>

    <!-- Gold bottom border — grows on hover -->
    <div class="absolute bottom-0 left-8 right-0 h-px bg-[var(--marga-gold)] scale-x-0 group-hover:scale-x-100 origin-left transition-transform duration-600 ease-out"></div>
  </a>

  <!-- Card body -->
  <div class="flex-1 flex flex-col px-6 py-6 space-y-4">

    <!-- Meta row -->
    <div class="flex items-center gap-3 text-[0.62rem] font-mono uppercase tracking-[0.16em] text-text-muted">
      <span>{exp.region}</span>
      <span class="w-px h-2.5 bg-canvas-border"></span>
      <span>{exp.bestSeason}</span>
    </div>

    <!-- Title -->
    <h3 class="font-editorial text-[1.35rem] sm:text-[1.5rem] font-medium text-text-primary leading-[1.2] tracking-[-0.01em] group-hover:text-accent-himalaya transition-colors duration-300">
      <a href={`/expeditions/${slug}`}>{exp.title}</a>
    </h3>

    <!-- Tagline -->
    <p class="font-sans text-[0.78rem] text-text-secondary leading-[1.7] line-clamp-2 font-normal">
      {exp.tagline}
    </p>

    <!-- Photographic highlights -->
    <ul class="space-y-1.5 pt-2 border-t border-canvas-border">
      {exp.highlights.slice(0, 2).map((highlight) => (
        <li class="flex items-start gap-2.5 text-[0.7rem] font-sans text-text-secondary font-normal leading-[1.6]">
          <span class="shrink-0 mt-0.5 w-3 h-px bg-[var(--marga-gold)]/80 mt-[0.5em]"></span>
          <span class="line-clamp-1">{highlight}</span>
        </li>
      ))}
    </ul>

    <!-- Footer row -->
    <div class="flex items-center justify-between pt-3 border-t border-canvas-border mt-auto">
      <div>
        <span class="block font-mono text-[0.55rem] uppercase tracking-[0.16em] text-text-muted">Field Status</span>
        <span class="flex items-center gap-1.5 mt-0.5 font-sans text-[0.68rem] text-text-secondary font-medium">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-600 animate-pulse"></span>
          2026 Inquiries Open
        </span>
      </div>

      <a
        href={`/expeditions/${slug}`}
        class="inline-flex items-center gap-2 font-mono text-[0.68rem] uppercase tracking-[0.18em] text-accent-himalaya hover:text-text-primary transition-colors duration-300 group/link font-medium"
      >
        <span>View Itinerary</span>
        <svg class="w-3.5 h-3.5 transition-transform duration-300 group-hover/link:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
        </svg>
      </a>
    </div>
  </div>
</article>

<style>
  .expedition-editorial-card {
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.4s ease, box-shadow 0.4s ease;
  }
  .expedition-editorial-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 16px 48px -12px rgba(0, 0, 0, 0.5);
  }
</style>
