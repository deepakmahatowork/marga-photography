---
interface Expedition {
  id: string;
  data: {
    title: string;
    tagline: string;
    heroImage: string;
    category: string;
    region: string;
    durationDays: number;
    groupSize: string;
    photographyLevel: string;
    difficulty: string;
    bestSeason: string;
    priceFrom: string;
    highlights: string[];
  };
}

interface Props {
  expedition: Expedition;
}

const { expedition } = Astro.props;
const exp = expedition.data;
const slug = expedition.id.replace(/\.(md|mdx|json)$/, '');
---

<article class="group bg-canvas-elevated border border-canvas-border rounded-lg overflow-hidden flex flex-col card-hover-border">
  <!-- Image Container -->
  <a href={`/expeditions/${slug}`} class="block relative aspect-[16/10] overflow-hidden">
    <img
      src={exp.heroImage}
      alt={exp.title}
      loading="lazy"
      decoding="async"
      class="w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-105"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-black/20"></div>

    <!-- Category Badge -->
    <div class="absolute top-4 left-4">
      <span class="inline-block px-3 py-1 bg-black/75 backdrop-blur-md border border-white/15 rounded text-[10px] tracking-[0.2em] uppercase font-semibold text-accent-himalaya">
        {exp.category}
      </span>
    </div>

    <!-- Duration & Group size -->
    <div class="absolute bottom-3 left-4 right-4 flex items-center justify-between text-xs text-white">
      <span class="flex items-center gap-1.5 font-medium drop-shadow-sm">
        <svg class="w-4 h-4 text-accent-himalaya" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        {exp.durationDays} Days
      </span>
      <span class="bg-black/70 backdrop-blur-sm px-2 py-0.5 rounded text-[11px] text-neutral-200 border border-white/10">
        {exp.groupSize}
      </span>
    </div>
  </a>

  <!-- Card Body -->
  <div class="p-6 flex-grow flex flex-col justify-between">
    <div>
      <div class="text-[11px] tracking-[0.2em] text-text-muted uppercase font-sans mb-1.5">
        {exp.region} • {exp.bestSeason}
      </div>
      <h3 class="font-editorial text-2xl font-medium text-text-primary group-hover:text-accent-himalaya transition-colors leading-snug">
        <a href={`/expeditions/${slug}`}>
          {exp.title}
        </a>
      </h3>
      <p class="text-xs text-text-secondary mt-2 line-clamp-2 leading-relaxed">
        {exp.tagline}
      </p>

      <!-- Photographic Highlights -->
      <ul class="mt-4 space-y-1.5 border-t border-canvas-border pt-3">
        {exp.highlights.slice(0, 2).map((highlight) => (
          <li class="text-[11px] text-text-secondary flex items-start gap-2">
            <span class="text-accent-himalaya shrink-0 mt-0.5">✦</span>
            <span class="line-clamp-1">{highlight}</span>
          </li>
        ))}
      </ul>
    </div>

    <!-- Card Footer -->
    <div class="mt-6 pt-4 border-t border-canvas-border flex flex-wrap sm:flex-nowrap items-center justify-between gap-3">
      <div>
        <span class="block text-[10px] uppercase tracking-wider text-text-muted">From</span>
        <span class="font-editorial text-lg text-text-primary font-medium">{exp.priceFrom}</span>
      </div>
      <a
        href={`/expeditions/${slug}`}
        class="inline-flex items-center gap-1 text-xs uppercase tracking-widest font-semibold text-accent-himalaya hover:text-text-primary transition-colors group/link"
      >
        View Itinerary
        <svg class="w-4 h-4 transition-transform group-hover/link:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
        </svg>
      </a>
    </div>
  </div>
</article>
