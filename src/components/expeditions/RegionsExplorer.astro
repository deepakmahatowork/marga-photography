---
interface Region {
  id: string;
  name: string;
  subhead: string;
  coordinates: string;
  elevation: string;
  description: string;
  image: string;
  link: string;
}

const regions: Region[] = [
  {
    id: 'mustang',
    name: 'Mustang',
    subhead: 'The Walled Kingdom of Lo',
    coordinates: "29°10' N · 83°57' E",
    elevation: '3,840M',
    description: 'Ancient walled Tibetan citadels, sacred red canyons, and masked monastic dramas during the sacred Tiji festival.',
    image: '/images/tiji_festival_dance.jpg',
    link: '/expeditions/tiji-festival-upper-mustang',
  },
  {
    id: 'khumbu',
    name: 'Khumbu',
    subhead: 'High Alpine Light & Glaciers',
    coordinates: "27°59' N · 86°43' E",
    elevation: '5,364M',
    description: 'Turquoise glacial lakes of Gokyo Ri and towering 8,000m summits stripped of noise at dawn and blue hour.',
    image: '/images/himalaya_dramatic_sunrise.jpg',
    link: '/expeditions/gokyo-everest-high-himalaya',
  },
  {
    id: 'bardia',
    name: 'Bardia',
    subhead: 'Wild Tiger & Sal Corridors',
    coordinates: "28°27' N · 81°18' E",
    elevation: '152M',
    description: 'Tracking solitary Royal Bengal Tigers and wild Asian elephants on unhurried walking safaris with master naturalists.',
    image: '/images/bardia_tiger_morning.jpg',
    link: '/expeditions/bardia-chitwan-wildlife-expedition',
  },
  {
    id: 'dolpo',
    name: 'Dolpo',
    subhead: 'Living Shamanic Highlands',
    coordinates: "28°29' N · 83°03' E",
    elevation: '2,850M',
    description: 'Remote ancestral mountain valleys where hereditary shamans channel spirits through resonant dhyangro drums.',
    image: '/images/dhorpatan_valley_landscape.jpg',
    link: '/expeditions/sacred-shamans-of-nepal',
  },
  {
    id: 'kathmandu',
    name: 'Kathmandu',
    subhead: 'Sacred Foundries & Butter Lamps',
    coordinates: "27°42' N · 85°19' E",
    elevation: '1,400M',
    description: 'Flickering terracotta oil lamp nights in Bhaktapur and private artisan ateliers preserving Newari sacred arts.',
    image: '/images/bhaktapur_heritage_lamps.jpg',
    link: '/expeditions/sacred-nepal-culture-people',
  },
];
---

<section
  id="regions-explorer"
  class="relative min-h-[90vh] py-32 sm:py-44 bg-[#161616] text-white overflow-hidden flex flex-col justify-between select-none"
  aria-label="Sacred Regions Explorer"
>
  <!-- Background Crossfade Images -->
  <div class="absolute inset-0 z-0 overflow-hidden pointer-events-none">
    {regions.map((region, index) => (
      <div
        class={`region-bg-frame absolute inset-0 transition-opacity duration-1000 ease-out ${
          index === 0 ? 'opacity-45' : 'opacity-0'
        }`}
        data-region-bg={region.id}
      >
        <img
          src={region.image}
          alt={region.name}
          class="w-full h-full object-cover filter brightness-[0.65] scale-105 transition-transform duration-[12000ms] ease-out"
          loading="lazy"
        />
      </div>
    ))}
    <!-- Atmospheric gradient overlays -->
    <div class="absolute inset-0 bg-gradient-to-t from-[#161616] via-black/30 to-[#161616]"></div>
    <div class="absolute inset-0 bg-radial from-transparent via-[#161616]/40 to-[#161616]/80"></div>
  </div>

  <!-- Top Centered Header (Snami "DISCOVER MORE DESTINATIONS" counterpart) -->
  <div class="relative z-10 text-center px-6 pt-6">
    <span class="font-sans text-[11px] uppercase tracking-[0.35em] text-white/70 font-semibold">
      DISCOVER SACRED REGIONS
    </span>
  </div>

  <!-- Middle Giant Marquee / Navigation Row (Snami large Dream Avenue destination titles) -->
  <div class="relative z-10 w-full px-4 sm:px-12 my-auto py-12">
    <div class="flex flex-wrap items-center justify-center gap-6 sm:gap-12 md:gap-16 lg:gap-20 text-center max-w-7xl mx-auto">
      {regions.map((region, index) => (
        <button
          type="button"
          class={`region-nav-item group font-dream text-[clamp(2.5rem,6.5vw,5.5rem)] tracking-tight uppercase transition-all duration-500 cursor-pointer ${
            index === 0 ? 'text-white' : 'text-white/40 hover:text-white'
          }`}
          data-region-id={region.id}
          aria-label={`Explore region ${region.name}`}
        >
          <span class="transition-transform duration-500 inline-block group-hover:-translate-y-1">
            {region.name}
          </span>
        </button>
      ))}
    </div>
  </div>

  <!-- Bottom Dynamic Details Dossier (Coordinates & Arrow Link) -->
  <div class="relative z-10 px-6 sm:px-12 max-w-3xl mx-auto text-center space-y-4 pb-6">
    <div class="flex items-center justify-center gap-4 text-[10px] sm:text-[11px] font-mono uppercase tracking-[0.3em] text-[#bea380]">
      <span id="region-dossier-coords">{regions[0].coordinates}</span>
      <span>·</span>
      <span id="region-dossier-elev">{regions[0].elevation}</span>
    </div>
    
    <p class="text-xs sm:text-sm text-neutral-300 font-light leading-relaxed max-w-xl mx-auto" id="region-dossier-desc">
      {regions[0].description}
    </p>

    <div class="pt-2">
      <a
        id="region-dossier-link"
        href={regions[0].link}
        class="snami-arrow-link text-white hover:text-[#bea380]"
      >
        <span>Discover Region</span>
        <span class="arrow-line"></span>
      </a>
    </div>
  </div>
</section>

<script>
  interface RegionInfo {
    coordinates: string;
    elevation: string;
    description: string;
    link: string;
  }

  const regionMap: Record<string, RegionInfo> = {
    mustang: {
      coordinates: "29°10' N · 83°57' E",
      elevation: '3,840M',
      description: 'Ancient walled Tibetan citadels, sacred red canyons, and masked monastic dramas during the sacred Tiji festival.',
      link: '/expeditions/tiji-festival-upper-mustang',
    },
    khumbu: {
      coordinates: "27°59' N · 86°43' E",
      elevation: '5,364M',
      description: 'Turquoise glacial lakes of Gokyo Ri and towering 8,000m summits stripped of noise at dawn and blue hour.',
      link: '/expeditions/gokyo-everest-high-himalaya',
    },
    bardia: {
      coordinates: "28°27' N · 81°18' E",
      elevation: '152M',
      description: 'Tracking solitary Royal Bengal Tigers and wild Asian elephants on unhurried walking safaris with master naturalists.',
      link: '/expeditions/bardia-chitwan-wildlife-expedition',
    },
    dolpo: {
      coordinates: "28°29' N · 83°03' E",
      elevation: '2,850M',
      description: 'Remote ancestral mountain valleys where hereditary shamans channel spirits through resonant dhyangro drums.',
      link: '/expeditions/sacred-shamans-of-nepal',
    },
    kathmandu: {
      coordinates: "27°42' N · 85°19' E",
      elevation: '1,400M',
      description: 'Flickering terracotta oil lamp nights in Bhaktapur and private artisan ateliers preserving Newari sacred arts.',
      link: '/expeditions/sacred-nepal-culture-people',
    },
  };

  function setupRegionsMarquee() {
    const navItems = document.querySelectorAll('.region-nav-item');
    const bgFrames = document.querySelectorAll('.region-bg-frame');
    const coordsEl = document.getElementById('region-dossier-coords');
    const elevEl = document.getElementById('region-dossier-elev');
    const descEl = document.getElementById('region-dossier-desc');
    const linkEl = document.getElementById('region-dossier-link') as HTMLAnchorElement;

    if (!navItems.length) return;

    function activateRegion(id: string) {
      const data = regionMap[id];
      if (!data) return;

      // Update background frame opacities
      bgFrames.forEach((bg) => {
        if (bg.getAttribute('data-region-bg') === id) {
          bg.classList.remove('opacity-0');
          bg.classList.add('opacity-45');
        } else {
          bg.classList.remove('opacity-45');
          bg.classList.add('opacity-0');
        }
      });

      // Update nav text opacities
      navItems.forEach((btn) => {
        if (btn.getAttribute('data-region-id') === id) {
          btn.classList.remove('text-white/40');
          btn.classList.add('text-white');
        } else {
          btn.classList.remove('text-white');
          btn.classList.add('text-white/40');
        }
      });

      // Update dossier text
      if (coordsEl) coordsEl.textContent = data.coordinates;
      if (elevEl) elevEl.textContent = data.elevation;
      if (descEl) descEl.textContent = data.description;
      if (linkEl) linkEl.href = data.link;
    }

    navItems.forEach((btn) => {
      const id = btn.getAttribute('data-region-id');
      if (!id) return;

      btn.addEventListener('mouseenter', () => activateRegion(id));
      btn.addEventListener('focus', () => activateRegion(id));
      btn.addEventListener('click', () => {
        activateRegion(id);
        const data = regionMap[id];
        if (data?.link) window.location.href = data.link;
      });
    });
  }

  setupRegionsMarquee();
  document.addEventListener('astro:page-load', setupRegionsMarquee);
</script>
