---
import ThemeToggle from './ThemeToggle.astro';
import { useTranslations } from '../../i18n/ui';

const currentPath = Astro.url.pathname;
const t = useTranslations('en');

const navLinks = [
  { href: '/', label: t('nav.home'), number: '01' },
  { href: '/expeditions', label: t('nav.expeditions'), number: '02' },
  {
    href: '/explore/people',
    label: t('nav.portfolios'),
    number: '03',
    children: [
      { href: '/explore/people', label: 'People & Portraits' },
      { href: '/explore/culture', label: 'Living Culture' },
      { href: '/explore/festivals', label: 'Sacred Festivals' },
      { href: '/explore/wildlife', label: 'Royal Bengal Wildlife' },
      { href: '/explore/landscapes', label: 'High Himalaya' },
    ],
  },
  { href: '/stories', label: t('nav.stories'), number: '04' },
  { href: '/commercial', label: t('nav.commercial'), number: '05' },
  { href: '/about', label: t('nav.about'), number: '06' },
  { href: '/contact', label: t('nav.contact'), number: '07' },
];
---

<!-- Fixed Top Navigation Bar (Snami Luxury Editorial Style) -->
<nav
  id="main-navbar"
  class="fixed top-0 left-0 w-full z-50 transition-all duration-500 will-change-transform transform-gpu bg-transparent py-4 sm:py-6 text-white"
>
  <div class="w-full max-w-[1920px] mx-auto px-4 sm:px-8 md:px-12 lg:px-16 flex justify-between items-center gap-2">
    
    <!-- Brand Logo & Name Only -->
    <a href="/" class="flex items-center gap-2 sm:gap-3 group cursor-pointer shrink min-w-0" aria-label="Marga Photography Home">
      <img
        src="/images/marga_photography_logo.png"
        alt="Marga Photography Logo"
        class="w-6 h-6 sm:w-9 sm:h-9 object-contain shrink-0 transition-transform duration-300 group-hover:scale-105"
      />
      <span class="font-editorial text-sm sm:text-xl font-medium tracking-[0.12em] sm:tracking-[0.14em] text-white uppercase whitespace-nowrap navbar-brand-text">
        Marga <span class="font-light text-[#bea380]">Photography</span>
      </span>
    </a>

    <!-- Right Controls -->
    <div class="flex items-center gap-2 sm:gap-5 md:gap-8 shrink-0">
      <!-- Phone Call Link (Snami Telephone Icon) -->
      <a
        href="tel:+9779800000000"
        class="text-white/75 hover:text-[#bea380] transition-colors p-2 hidden sm:flex items-center justify-center"
        aria-label="Direct Dispatch Phone"
      >
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
        </svg>
      </a>


      <!-- Theme Switcher -->
      <ThemeToggle id="theme-toggle-btn" />

      <!-- The Signature Snami 2-Line Hamburger Button -->
      <button
        id="hamburger-menu-btn"
        type="button"
        class="flex items-center gap-2 group p-2 cursor-pointer select-none focus:outline-none focus:ring-1 focus:ring-[#bea380] rounded-lg shrink-0 min-w-[44px] min-h-[44px] justify-center touch-manipulation"
        aria-label="Open main navigation menu"
        aria-expanded="false"
      >
        <div class="flex flex-col gap-1.5 p-1 transition-all pointer-events-none">
          <div class="h-[1.5px] transition-all duration-300 bg-white w-6 sm:w-8 group-hover:bg-[#bea380] hamburger-line"></div>
          <div class="h-[1.5px] transition-all duration-300 bg-white w-6 sm:w-8 group-hover:bg-[#bea380] hamburger-line"></div>
        </div>
      </button>

      <!-- The Iconic Snami Circular REQUEST Button -->
      <a
        href="/contact?intent=expedition"
        class="snami-circle-btn"
        aria-label="Request an Expedition"
      >
        <span>REQUEST</span>
      </a>
    </div>
  </div>
</nav>

<!-- Full-Screen Navigation Overlay Modal (Snami Split Drawer) -->
<div
  id="fullscreen-menu"
  class="fixed inset-0 h-[100dvh] z-[100] bg-[#0B0D12]/98 backdrop-blur-2xl text-white hidden flex-col font-sans transition-opacity duration-300"
  role="dialog"
  aria-modal="true"
  aria-label="Navigation Menu"
>
  <!-- Top Bar with Close Button -->
  <div class="w-full max-w-[1920px] mx-auto px-5 sm:px-8 md:px-12 lg:px-16 py-5 sm:py-6 flex justify-between items-center border-b border-white/10 shrink-0">
    <!-- Brand in Menu -->
    <a href="/" class="flex items-center gap-3 group menu-link">
      <img
        src="/images/marga_photography_logo.png"
        alt="Marga Photography Logo"
        class="w-8 h-8 sm:w-9 sm:h-9 object-contain shrink-0"
      />
      <span class="font-editorial text-base sm:text-xl font-medium tracking-[0.14em] text-white uppercase whitespace-nowrap">
        Marga <span class="font-light text-[#bea380]">Photography</span>
      </span>
    </a>

    <!-- Close Controls -->
    <div class="flex items-center gap-3 sm:gap-6">

      <!-- Close Button -->
      <button
        id="close-menu-btn"
        type="button"
        class="group flex items-center gap-2.5 sm:gap-3 p-2 cursor-pointer focus:outline-none focus:ring-1 focus:ring-[#D4A359] rounded-full shrink-0 min-w-[44px] min-h-[44px] justify-center touch-manipulation"
        aria-label="Close navigation menu"
      >
        <span class="text-[10px] font-mono uppercase tracking-[0.4em] text-white/50 group-hover:text-white hidden sm:block">
          {t('nav.close')}
        </span>
        <div class="w-10 h-10 border border-white/20 rounded-full flex items-center justify-center group-hover:bg-[#D4A359] group-hover:text-black group-hover:border-[#D4A359] transition-all duration-300 text-white pointer-events-none">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </div>
      </button>
    </div>
  </div>

  <!-- Menu Body Layout (Split Columns) -->
  <div class="flex-1 min-h-0 flex flex-col xl:flex-row relative z-10 overflow-hidden">
    
    <!-- Left Column: Primary Navigation Items -->
    <div class="w-full xl:w-[48%] flex flex-col justify-between px-6 sm:px-12 md:pl-16 lg:pl-24 gap-8 overflow-y-auto min-h-0 flex-1 overscroll-contain pt-8 md:pt-12 pb-12 border-r border-white/10">
      <nav class="flex flex-col space-y-4 md:space-y-6 shrink-0" aria-label="Overlay Navigation">
        {navLinks.map((item) => {
          const isActive = currentPath === item.href || (item.href !== '/' && currentPath.startsWith(item.href));
          return (
            <div class="group/item">
              <div class="flex items-baseline gap-4 sm:gap-6">
                <span class="font-mono text-[11px] text-white/40 tracking-widest group-hover/item:text-[#D4A359] transition-colors">
                  {item.number}
                </span>
                <a
                  href={item.href}
                  class={`menu-link font-editorial text-3xl sm:text-5xl lg:text-5xl font-light tracking-tight transition-all duration-300 hover:translate-x-3 ${
                    isActive ? 'text-[#D4A359]' : 'text-white/90 hover:text-[#D4A359]'
                  }`}
                >
                  {item.label}
                </a>
              </div>

              {/* Submenu for Portfolios */}
              {item.children && (
                <div class="pl-9 sm:pl-12 mt-3 flex flex-wrap gap-2 sm:gap-3">
                  {item.children.map((sub) => (
                    <a
                      href={sub.href}
                      class="menu-link text-[11px] uppercase tracking-[0.15em] py-1.5 px-3.5 rounded-full bg-white/5 border border-white/10 hover:border-[#D4A359] hover:text-[#D4A359] active:bg-[#D4A359] active:text-black transition-all touch-manipulation text-white/70"
                    >
                      {sub.label}
                    </a>
                  ))}
                </div>
              )}
            </div>
          );
        })}
      </nav>

      <!-- Bottom Quick Contact in Drawer -->
      <div class="pt-6 border-t border-white/10 flex flex-col sm:flex-row sm:items-center justify-between gap-4 text-xs text-white/50 shrink-0 pb-4">
        <div>
          <span class="uppercase tracking-wider font-mono text-[10px]">Direct Dispatch: </span>
          <a href="mailto:expeditions@margaphotography.com" class="text-[#D4A359] hover:underline font-mono">
            expeditions@margaphotography.com
          </a>
        </div>
        <div class="font-mono text-[10px] tracking-wider uppercase">
          <span>Infrastructure Partner: </span>
          <a href="https://margaadventure.com" target="_blank" rel="noopener noreferrer" class="text-white hover:text-[#D4A359] underline">
            Marga Adventure
          </a>
        </div>
      </div>
    </div>

    <!-- Right Column: Visual Showcase Card (Desktop) -->
    <div class="hidden xl:flex flex-1 relative overflow-hidden items-center justify-center p-12 lg:p-16 bg-[#0E1017]">
      <div class="max-w-md w-full p-8 rounded-2xl bg-[#141822] border border-white/10 shadow-2xl space-y-6">
        <div class="aspect-[16/10] rounded-xl overflow-hidden relative editorial-img-frame">
          <img
            src="/images/patrick_frilet_portrait.jpg"
            alt="Field Master & Mentor Patrick Frilet"
            class="w-full h-full object-cover object-top"
          />
          <div class="absolute top-3 left-3 px-3 py-1 bg-black/80 backdrop-blur-md rounded-full text-[9px] uppercase tracking-[0.25em] text-[#D4A359] font-mono border border-white/10">
            2026 Expeditions Open
          </div>
        </div>

        <div>
          <span class="text-[10px] uppercase tracking-[0.3em] text-[#D4A359] font-mono block mb-1">
            Intimate Masterclasses
          </span>
          <h4 class="font-editorial text-2xl text-white font-light">
            Strictly 4 to 6 Photographers
          </h4>
          <p class="text-xs text-white/60 leading-relaxed mt-2 font-light">
            Every departure is scheduled precisely around sacred seasonal calendar dates, ancient masked rituals, and optimum Himalayan light windows.
          </p>
        </div>

        <div class="pt-4 border-t border-white/10 flex items-center justify-between">
          <a
            href="/expeditions"
            class="menu-link px-6 py-2.5 bg-[#D4A359] hover:bg-white text-black font-semibold text-[11px] uppercase tracking-[0.2em] rounded-full transition-all duration-300 shadow-md"
          >
            Explore Itineraries →
          </a>
          <span class="text-[10px] font-mono text-white/40 tracking-wider">NEPAL · MUSTANG · TERAI</span>
        </div>
      </div>
    </div>

  </div>
</div>

<script>
  // Scroll reactive navbar
  const navbar = document.getElementById('main-navbar');
  
  function handleScroll() {
    if (!navbar) return;
    if (window.scrollY > 20) {
      navbar.classList.add('navbar-scrolled');
    } else {
      navbar.classList.remove('navbar-scrolled');
    }
  }

  window.addEventListener('scroll', handleScroll, { passive: true });
  handleScroll();

  // Full-screen Menu Open / Close logic
  const menuBtn = document.getElementById('hamburger-menu-btn');
  const closeBtn = document.getElementById('close-menu-btn');
  const fullscreenMenu = document.getElementById('fullscreen-menu');
  const menuLinks = document.querySelectorAll('.menu-link');

  function openMenu() {
    if (!fullscreenMenu) return;
    fullscreenMenu.classList.remove('hidden');
    fullscreenMenu.classList.add('flex');
    document.body.style.overflow = 'hidden';
    menuBtn?.setAttribute('aria-expanded', 'true');
    closeBtn?.focus();
  }

  function closeMenu() {
    if (!fullscreenMenu) return;
    fullscreenMenu.classList.add('hidden');
    fullscreenMenu.classList.remove('flex');
    document.body.style.overflow = '';
    menuBtn?.setAttribute('aria-expanded', 'false');
    menuBtn?.focus();
  }

  menuBtn?.addEventListener('click', openMenu);
  closeBtn?.addEventListener('click', closeMenu);

  // Close menu only for hash anchors or when clicking the current page's own link
  menuLinks.forEach((link) => {
    link.addEventListener('click', () => {
      const href = link.getAttribute('href');
      if (!href) return;
      const current = window.location.pathname;
      if (
        href.startsWith('#') ||
        href === current ||
        href === current + '/' ||
        href === current.replace(/\/$/, '')
      ) {
        closeMenu();
      }
      // For cross-page navigation, allow the browser to follow the link naturally
    });
  });

  window.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && fullscreenMenu && !fullscreenMenu.classList.contains('hidden')) {
      closeMenu();
    }
  });
</script>
