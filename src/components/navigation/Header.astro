---
import ThemeToggle from './ThemeToggle.astro';
import LanguageSwitcher from './LanguageSwitcher.astro';
import { useTranslations, type Lang } from '../../i18n/ui';

const currentPath = Astro.url.pathname;
const isFrench = currentPath.startsWith('/fr');
const lang: Lang = isFrench ? 'fr' : 'en';
const t = useTranslations(lang);
const langPrefix = isFrench ? '/fr' : '';

const navLinks = [
  { href: isFrench ? '/fr' : '/', label: t('nav.home'), number: '01' },
  { href: `${langPrefix}/expeditions`, label: t('nav.expeditions'), number: '02' },
  {
    href: `${langPrefix}/explore/people`,
    label: t('nav.portfolios'),
    number: '03',
    children: [
      { href: `${langPrefix}/explore/people`, label: isFrench ? 'Portraits & Peuples' : 'People & Portraits' },
      { href: `${langPrefix}/explore/culture`, label: isFrench ? 'Cultures Vivantes' : 'Living Culture' },
      { href: `${langPrefix}/explore/festivals`, label: isFrench ? 'Festivals Sacrés' : 'Sacred Festivals' },
      { href: `${langPrefix}/explore/wildlife`, label: isFrench ? 'Faune Royale du Bengale' : 'Royal Bengal Wildlife' },
      { href: `${langPrefix}/explore/landscapes`, label: isFrench ? 'Haute Himalaya' : 'High Himalaya' },
    ],
  },
  { href: `${langPrefix}/stories`, label: t('nav.stories'), number: '04' },
  { href: `${langPrefix}/commercial`, label: t('nav.commercial'), number: '05' },
  { href: `${langPrefix}/about`, label: t('nav.about'), number: '06' },
  { href: `${langPrefix}/contact`, label: t('nav.contact'), number: '07' },
];
---

<!-- Fixed Top Navigation Bar (Marga Adventure Style) -->
<nav
  id="main-navbar"
  class="fixed top-0 left-0 w-full z-50 transition-all duration-300 will-change-transform transform-gpu bg-canvas-bg/90 backdrop-blur-md border-b border-canvas-border/60 py-3 sm:py-4 md:py-6 shadow-xs"
>
  <div class="w-full max-w-[1920px] mx-auto px-4 sm:px-6 md:px-10 lg:px-16 flex justify-between items-center">
    
    <!-- Brand Logo & Title -->
    <a href={isFrench ? '/fr' : '/'} class="flex items-center gap-2 sm:gap-3 md:gap-3.5 group cursor-pointer shrink min-w-0">
      <img
        src="/images/marga_photography_logo.png"
        alt="Marga Photography Logo"
        class="w-9 h-9 sm:w-10 sm:h-10 md:w-12 md:h-12 object-contain transition-transform duration-300 group-hover:scale-105 shrink-0"
      />
      <span class="font-bold tracking-tight text-base sm:text-xl md:text-2xl transition-colors duration-500 font-sans text-text-primary truncate">
        Marga <span class="font-light text-accent-himalaya">Photography</span>
      </span>
    </a>

    <!-- Right Controls -->
    <div class="flex items-center gap-2 sm:gap-3 md:gap-6 shrink-0">
      <!-- Language Switcher (EN / FR) -->
      <LanguageSwitcher />

      <!-- Theme Switcher -->
      <ThemeToggle id="theme-toggle-btn" />

      <!-- Direct Expedition CTA -->
      <a
        href={`${langPrefix}/contact?intent=expedition`}
        class="hidden sm:inline-flex items-center justify-center px-4 md:px-5 py-2 text-xs font-semibold uppercase tracking-[0.15em] text-white bg-accent-himalaya hover:bg-brand-dark transition-all rounded-full shadow-sm"
      >
        {t('nav.request_expedition')}
      </a>

      <!-- The Signature Marga Adventure Hamburger Button -->
      <button
        id="hamburger-menu-btn"
        type="button"
        class="flex items-center gap-2 md:gap-4 group p-2 sm:p-2.5 md:p-3 cursor-pointer select-none focus:outline-none focus:ring-2 focus:ring-accent-himalaya rounded-lg shrink-0 min-w-[44px] min-h-[44px] justify-center touch-manipulation"
        aria-label="Open main navigation menu"
        aria-expanded="false"
      >
        <span class="text-[10px] font-bold uppercase tracking-[0.5em] transition-all duration-500 hidden lg:block text-text-muted group-hover:text-accent-himalaya">
          {t('nav.navigation')}
        </span>
        <div class="flex flex-col gap-1.5 p-1 transition-all pointer-events-none">
          <div class="h-0.5 transition-all duration-300 bg-text-primary w-6 md:w-8 group-hover:w-5 md:group-hover:w-6"></div>
          <div class="h-0.5 transition-all duration-300 bg-text-primary w-5 md:w-6 group-hover:w-6 md:group-hover:w-8"></div>
          <div class="h-0.5 transition-all duration-300 bg-text-primary w-3 md:w-4 group-hover:w-6 md:group-hover:w-8"></div>
        </div>
      </button>
    </div>
  </div>
</nav>

<!-- Full-Screen Navigation Overlay Modal (Marga Adventure Style) -->
<div
  id="fullscreen-menu"
  class="fixed inset-0 h-[100dvh] z-[100] bg-canvas-bg/98 backdrop-blur-2xl text-text-primary hidden flex-col font-sans transition-opacity duration-300"
  role="dialog"
  aria-modal="true"
  aria-label="Navigation Menu"
>
  <!-- Top Bar with Close Button -->
  <div class="w-full max-w-[1920px] mx-auto px-4 sm:px-6 md:px-10 lg:px-16 py-4 sm:py-5 md:py-8 flex justify-between items-center border-b border-canvas-border shrink-0">
    <!-- Brand in Menu -->
    <a href={isFrench ? '/fr' : '/'} class="flex items-center gap-3 group menu-link">
      <img
        src="/images/marga_photography_logo.png"
        alt="Marga Photography Logo"
        class="w-9 h-9 sm:w-10 sm:h-10 object-contain shrink-0"
      />
      <span class="font-bold tracking-tight text-lg sm:text-xl text-text-primary">
        Marga <span class="font-light text-accent-himalaya">Photography</span>
      </span>
    </a>

    <!-- Close Controls -->
    <div class="flex items-center gap-2 sm:gap-6">
      <LanguageSwitcher />

      <!-- Close Button -->
      <button
        id="close-menu-btn"
        type="button"
        class="group flex items-center gap-2 sm:gap-3 p-2 cursor-pointer focus:outline-none focus:ring-2 focus:ring-accent-himalaya rounded-full shrink-0 min-w-[44px] min-h-[44px] justify-center touch-manipulation"
        aria-label="Close navigation menu"
      >
        <span class="text-[10px] font-bold uppercase tracking-[0.4em] text-text-muted group-hover:text-text-primary hidden sm:block">
          {t('nav.close')}
        </span>
        <div class="w-10 h-10 md:w-11 md:h-11 border border-canvas-border rounded-full flex items-center justify-center group-hover:bg-accent-himalaya group-hover:text-white group-hover:border-accent-himalaya transition-all text-text-primary shadow-sm pointer-events-none">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </div>
      </button>
    </div>
  </div>

  <!-- Menu Body Layout (Split Columns) -->
  <div class="flex-1 min-h-0 flex flex-col xl:flex-row relative z-10 overflow-hidden">
    
    <!-- Left Column: Primary Navigation Items -->
    <div class="w-full xl:w-[45%] flex flex-col justify-between px-6 sm:px-10 md:pl-16 lg:pl-24 gap-8 overflow-y-auto min-h-0 flex-1 overscroll-contain pt-6 md:pt-8 pb-12 border-r border-canvas-border">
      <nav class="flex flex-col space-y-4 md:space-y-6 shrink-0" aria-label="Overlay Navigation">
        {navLinks.map((item) => {
          const isActive = currentPath === item.href || (item.href !== '/' && currentPath.startsWith(item.href));
          return (
            <div class="group/item">
              <div class="flex items-baseline gap-4">
                <span class="font-mono text-xs text-text-muted group-hover/item:text-accent-himalaya transition-colors">
                  {item.number}
                </span>
                <a
                  href={item.href}
                  class={`menu-link font-editorial text-2xl sm:text-4xl lg:text-5xl font-normal transition-all duration-300 hover:translate-x-2 ${
                    isActive ? 'text-accent-himalaya' : 'text-text-primary hover:text-accent-himalaya'
                  }`}
                >
                  {item.label}
                </a>
              </div>

              {/* Submenu for Portfolios */}
              {item.children && (
                <div class="pl-8 sm:pl-10 mt-3 flex flex-wrap gap-2 sm:gap-x-4 sm:gap-y-2">
                  {item.children.map((sub) => (
                    <a
                      href={sub.href}
                      class="menu-link text-xs uppercase tracking-wider py-1.5 px-3 rounded-full bg-canvas-surface/80 border border-canvas-border hover:border-accent-himalaya hover:text-accent-himalaya active:bg-accent-himalaya active:text-white transition-all touch-manipulation"
                    >
                      {sub.label}
                    </a>
                  ))}
                </div>
              )}
            </div>
          );
        })}
      </nav>

      <!-- Bottom Quick Contact in Drawer -->
      <div class="pt-6 border-t border-canvas-border flex flex-col sm:flex-row sm:items-center justify-between gap-4 text-xs text-text-muted shrink-0 pb-6">
        <div>
          <span>Direct Dispatch: </span>
          <a href="mailto:expeditions@margaphotography.com" class="text-accent-himalaya hover:underline font-medium">
            expeditions@margaphotography.com
          </a>
        </div>
        <div>
          <span>Partner: </span>
          <a href="https://margaadventure.com" target="_blank" rel="noopener noreferrer" class="hover:text-text-primary underline">
            Marga Adventure
          </a>
        </div>
      </div>
    </div>

    <!-- Right Column: Visual Showcase Card (Desktop) -->
    <div class="hidden xl:flex flex-1 relative overflow-hidden items-center justify-center p-12 lg:p-16 bg-canvas-surface/40">
      <div class="max-w-md w-full p-8 rounded-2xl bg-canvas-elevated border border-canvas-border shadow-2xl space-y-6">
        <div class="aspect-[16/10] rounded-xl overflow-hidden relative">
          <img
            src="/images/himalaya_morning_light.jpg"
            alt="High Himalaya Sanctuary"
            class="w-full h-full object-cover"
          />
          <div class="absolute top-3 left-3 px-2.5 py-1 bg-black/70 backdrop-blur-md rounded text-[10px] uppercase tracking-widest text-accent-himalaya font-semibold border border-white/10">
            2026 Expeditions Open
          </div>
        </div>

        <div>
          <span class="text-xs uppercase tracking-[0.2em] text-accent-himalaya font-semibold block mb-1">
            Intimate Field Masterclasses
          </span>
          <h4 class="font-editorial text-2xl text-text-primary font-medium">
            Strictly 4 to 6 Photographers
          </h4>
          <p class="text-xs text-text-secondary leading-relaxed mt-2">
            Every departure is scheduled precisely around sacred seasonal calendar dates and optimum Himalayan light windows.
          </p>
        </div>

        <div class="pt-4 border-t border-canvas-border flex items-center justify-between">
          <a
            href="/expeditions"
            class="menu-link px-6 py-2.5 bg-accent-himalaya hover:opacity-90 text-white dark:text-black font-semibold text-xs uppercase tracking-widest rounded-full transition-all shadow-md"
          >
            Explore Itineraries →
          </a>
          <span class="text-xs font-mono text-text-muted">Nepal • Bhutan • Tibet</span>
        </div>
      </div>
    </div>

  </div>
</div>

<script>
  // Scroll reactive navbar
  const navbar = document.getElementById('main-navbar');
  
  function handleScroll() {
    if (!navbar) return;
    if (window.scrollY > 20) {
      navbar.classList.add('shadow-md', 'border-canvas-border');
      navbar.classList.remove('border-canvas-border/60');
    } else {
      navbar.classList.remove('shadow-md');
      navbar.classList.add('border-canvas-border/60');
    }
  }

  window.addEventListener('scroll', handleScroll, { passive: true });
  handleScroll();

  // Full-screen Menu Open / Close logic
  const menuBtn = document.getElementById('hamburger-menu-btn');
  const closeBtn = document.getElementById('close-menu-btn');
  const fullscreenMenu = document.getElementById('fullscreen-menu');
  const menuLinks = document.querySelectorAll('.menu-link');

  function openMenu() {
    if (!fullscreenMenu) return;
    fullscreenMenu.classList.remove('hidden');
    fullscreenMenu.classList.add('flex');
    document.body.style.overflow = 'hidden';
    menuBtn?.setAttribute('aria-expanded', 'true');
    closeBtn?.focus();
  }

  function closeMenu() {
    if (!fullscreenMenu) return;
    fullscreenMenu.classList.add('hidden');
    fullscreenMenu.classList.remove('flex');
    document.body.style.overflow = '';
    menuBtn?.setAttribute('aria-expanded', 'false');
    menuBtn?.focus();
  }

  menuBtn?.addEventListener('click', openMenu);
  closeBtn?.addEventListener('click', closeMenu);

  // Close menu only for hash anchors or when clicking the current page's own link
  menuLinks.forEach((link) => {
    link.addEventListener('click', () => {
      const href = link.getAttribute('href');
      if (!href) return;
      const current = window.location.pathname;
      if (
        href.startsWith('#') ||
        href === current ||
        href === current + '/' ||
        href === current.replace(/\/$/, '')
      ) {
        closeMenu();
      }
      // For cross-page navigation, allow the browser to follow the link naturally
    });
  });

  window.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && fullscreenMenu && !fullscreenMenu.classList.contains('hidden')) {
      closeMenu();
    }
  });
</script>
