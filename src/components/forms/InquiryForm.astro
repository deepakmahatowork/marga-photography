---
interface Props {
  expeditionTitle?: string;
  defaultCategory?: string;
}

const { expeditionTitle, defaultCategory } = Astro.props;
---

<div class="bg-canvas-elevated border border-canvas-border p-6 sm:p-10 shadow-lg relative">
  <!-- Subtle top accent rule -->
  <div class="w-12 h-px mb-6" style="background-color: var(--marga-gold)"></div>

  <form
    id="inquiry-form"
    action="https://api.web3forms.com/submit"
    method="POST"
    class="space-y-5"
  >
    <!-- Web3Forms Access Key -->
    <input type="hidden" name="access_key" value="936a98cf-f8fc-47e0-a7ca-8720b09e4b40" />

    <!-- Web3Forms Customization -->
    <input type="hidden" name="subject" value={expeditionTitle ? `New Expedition Inquiry: ${expeditionTitle}` : 'New Inquiry — Marga Photography'} />
    <input type="hidden" name="from_name" value="Marga Photography" />

    <!-- Web3Forms Anti-Bot Honeypot -->
    <input type="checkbox" name="botcheck" class="hidden" style="display: none;" tabindex="-1" autocomplete="off" />

    <!-- Expedition Context -->
    <input type="hidden" name="expedition" value={expeditionTitle || 'General / Custom Expedition'} />
    {defaultCategory && <input type="hidden" name="category" value={defaultCategory} />}

    <!-- Name + Email row -->
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
      <div>
        <label for="name" class="block text-[10px] uppercase tracking-[0.22em] font-semibold mb-2" style="color: var(--color-text-muted)">
          Name <span style="color: var(--marga-gold)">*</span>
        </label>
        <input
          type="text"
          id="name"
          name="name"
          required
          placeholder="Your full name"
          class="inquiry-input w-full px-4 py-3 text-sm"
        />
      </div>

      <div>
        <label for="email" class="block text-[10px] uppercase tracking-[0.22em] font-semibold mb-2" style="color: var(--color-text-muted)">
          Email <span style="color: var(--marga-gold)">*</span>
        </label>
        <input
          type="email"
          id="email"
          name="email"
          required
          placeholder="you@example.com"
          class="inquiry-input w-full px-4 py-3 text-sm"
        />
      </div>
    </div>

    <!-- Phone -->
    <div>
      <label for="phone" class="block text-[10px] uppercase tracking-[0.22em] font-semibold mb-2" style="color: var(--color-text-muted)">
        Phone / WhatsApp
      </label>
      <input
        type="tel"
        id="phone"
        name="phone"
        placeholder="+1 555 000 0000"
        class="inquiry-input w-full px-4 py-3 text-sm"
      />
    </div>

    <!-- Message -->
    <div>
      <label for="message" class="block text-[10px] uppercase tracking-[0.22em] font-semibold mb-2" style="color: var(--color-text-muted)">
        Message <span style="color: var(--marga-gold)">*</span>
      </label>
      <textarea
        id="message"
        name="message"
        rows="4"
        required
        placeholder="Tell us what you'd like to photograph in Nepal..."
        class="inquiry-input w-full px-4 py-3 text-sm resize-none"
      ></textarea>
    </div>

    <!-- Status banner -->
    <div id="form-status" class="hidden text-xs p-4 border transition-all" role="alert" aria-live="polite"></div>

    <!-- Submit -->
    <div class="flex items-center gap-5 pt-1">
      <button
        type="submit"
        id="submit-btn"
        class="inline-flex items-center gap-2 px-7 py-3 text-[11px] font-bold uppercase tracking-[0.22em] transition-all duration-300 cursor-pointer"
        style="background-color: var(--marga-gold); color: #ffffff; border: 1px solid var(--marga-gold);"
      >
        <span id="btn-text">Submit</span>
        <svg id="btn-spinner" class="hidden animate-spin h-3.5 w-3.5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
          <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
          <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"></path>
        </svg>
      </button>
      <p class="text-[10px] leading-relaxed" style="color: var(--color-text-muted)">
        We reply within 24 hours.
      </p>
    </div>
  </form>
</div>

<script>
  function setupInquiryForm() {
    const form = document.getElementById('inquiry-form') as HTMLFormElement;
    const statusDiv = document.getElementById('form-status');
    const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;
    const btnText = document.getElementById('btn-text');
    const btnSpinner = document.getElementById('btn-spinner');

    if (!form || !statusDiv || !submitBtn) return;

    // Prevent attaching multiple listeners across view transitions
    if (form.dataset.initialized === 'true') return;
    form.dataset.initialized = 'true';

    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      // Client honeypot check
      const botcheck = (form.elements.namedItem('botcheck') as HTMLInputElement)?.checked;
      if (botcheck) {
        return; // Silent discard for bots
      }

      // UI Loading State
      submitBtn.disabled = true;
      btnSpinner?.classList.remove('hidden');
      if (btnText) btnText.textContent = 'Submitting...';
      statusDiv.classList.add('hidden');

      const formData = new FormData(form);
      const data = Object.fromEntries(formData.entries());

      try {
        const response = await fetch('https://api.web3forms.com/submit', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            Accept: 'application/json',
          },
          body: JSON.stringify(data),
        });

        const result = await response.json();

        if (response.status === 200 && result.success) {
          form.reset();
          statusDiv.className = 'block p-4 rounded border bg-emerald-500/10 border-emerald-500/30 text-emerald-800 dark:text-emerald-200 text-xs';
          statusDiv.innerHTML = `
            <strong class="font-semibold block mb-1">✓ Inquiry Received Successfully</strong>
            Thank you for reaching out to Marga Photography. Your message has been safely delivered, and our expedition lead will follow up directly with itinerary details and availability within 24 hours.
          `;
        } else {
          throw new Error(result.message || 'Submission failed. Please verify your entries.');
        }
      } catch (err: any) {
        statusDiv.className = 'block p-4 rounded border bg-rose-500/10 border-rose-500/30 text-rose-800 dark:text-rose-200 text-xs';
        statusDiv.innerHTML = `
          <strong class="font-semibold block mb-1">Notice:</strong>
          ${err.message || 'Unable to submit at this moment. You can also write directly to expeditions@margaphotography.com.'}
        `;
      } finally {
        submitBtn.disabled = false;
        btnSpinner?.classList.add('hidden');
        if (btnText) btnText.textContent = 'Submit';
      }
    });
  }

  setupInquiryForm();
  document.addEventListener('astro:page-load', setupInquiryForm);
</script>
