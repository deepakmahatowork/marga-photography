---
interface Props {
  class?: string;
  title?: string;
  subtitle?: string;
}

const {
  class: className = '',
  title = 'Executive Leadership & Operational Partner',
  subtitle = 'Official Marga Adventure direct credentials and field dispatch'
} = Astro.props;
---

<div class={`business-card-wrapper ${className}`}>
  {title && (
    <div class="mb-4">
      <span class="text-[11px] uppercase tracking-[0.25em] text-accent-himalaya font-sans font-semibold block">
        {title}
      </span>
      {subtitle && (
        <p class="text-xs text-text-secondary mt-1">
          {subtitle}
        </p>
      )}
    </div>
  )}

  <!-- Interactive Card Container -->
  <div class="relative group perspective-1000 max-w-lg">
    <!-- Flip Switcher Buttons -->
    <div class="flex items-center justify-between mb-3">
      <div class="inline-flex p-1 rounded-full bg-canvas-surface border border-canvas-border text-[11px] font-medium" role="tablist">
        <button
          type="button"
          id="card-btn-front"
          class="px-3 py-1 rounded-full bg-accent-himalaya text-white font-semibold transition-all shadow-xs cursor-pointer"
          aria-selected="true"
        >
          Card Front (CEO & Contact)
        </button>
        <button
          type="button"
          id="card-btn-back"
          class="px-3 py-1 rounded-full text-text-muted hover:text-text-primary transition-all cursor-pointer"
          aria-selected="false"
        >
          Card Back (Scan QR)
        </button>
      </div>

      <span class="text-[10px] text-text-muted font-mono hidden sm:inline-block">
        Click to flip or switch
      </span>
    </div>

    <!-- 3D Card Flipper Container -->
    <div
      id="business-card-flipper"
      class="relative w-full aspect-[1023/602] transition-transform duration-700 transform-style-3d cursor-pointer rounded-2xl shadow-xl hover:shadow-2xl overflow-hidden border border-canvas-border bg-canvas-surface"
      title="Click to flip card"
    >
      <!-- FRONT SIDE -->
      <div
        id="card-side-front"
        class="absolute inset-0 w-full h-full backface-hidden transition-opacity duration-300"
      >
        <img
          src="/images/business_card_front.png"
          alt="Buddhiman Tamang, CEO Marga Adventure Business Card Front"
          class="w-full h-full object-cover rounded-2xl"
          loading="lazy"
        />
      </div>

      <!-- BACK SIDE -->
      <div
        id="card-side-back"
        class="absolute inset-0 w-full h-full backface-hidden opacity-0 pointer-events-none transition-opacity duration-300"
      >
        <img
          src="/images/business_card_back.png"
          alt="Marga Adventure Business Card Back - Scan QR and The Path is Infinite"
          class="w-full h-full object-cover rounded-2xl"
          loading="lazy"
        />
      </div>
    </div>

    <!-- Quick Action Contact Strip -->
    <div class="mt-4 p-4 rounded-xl bg-canvas-surface border border-canvas-border flex flex-wrap items-center justify-between gap-3 text-xs">
      <div class="flex items-center gap-2">
        <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
        <span class="text-text-primary font-medium">Buddhiman Tamang</span>
        <span class="text-text-muted">• CEO</span>
      </div>

      <div class="flex items-center gap-2 sm:gap-3">
        <a
          href="tel:+9779841008984"
          class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-accent-himalaya/10 hover:bg-accent-himalaya text-accent-himalaya hover:text-white transition-colors font-mono text-[11px] font-semibold"
          title="Direct Phone / WhatsApp"
        >
          <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z" />
          </svg>
          Call
        </a>

        <a
          href="mailto:buddhimaaan@gmail.com"
          class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-canvas-elevated hover:bg-accent-himalaya text-text-primary hover:text-white border border-canvas-border transition-colors text-[11px] font-medium"
          title="Send Direct Email"
        >
          <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z" />
            <polyline points="22,6 12,13 2,6" />
          </svg>
          Email
        </a>

        <a
          href="https://margaadventure.com"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-canvas-elevated hover:bg-accent-himalaya text-text-primary hover:text-white border border-canvas-border transition-colors text-[11px] font-medium"
        >
          Website ↗
        </a>
      </div>
    </div>
  </div>
</div>

<script>
  function setupBusinessCard() {
    const flipper = document.getElementById('business-card-flipper');
    const frontSide = document.getElementById('card-side-front');
    const backSide = document.getElementById('card-side-back');
    const btnFront = document.getElementById('card-btn-front');
    const btnBack = document.getElementById('card-btn-back');

    if (!flipper || !frontSide || !backSide || !btnFront || !btnBack) return;

    let showingFront = true;

    function updateCardView(toFront: boolean) {
      showingFront = toFront;
      if (showingFront) {
        frontSide.classList.remove('opacity-0', 'pointer-events-none');
        backSide.classList.add('opacity-0', 'pointer-events-none');

        btnFront.classList.add('bg-accent-himalaya', 'text-white', 'font-semibold', 'shadow-xs');
        btnFront.classList.remove('text-text-muted');
        btnBack.classList.remove('bg-accent-himalaya', 'text-white', 'font-semibold', 'shadow-xs');
        btnBack.classList.add('text-text-muted');
      } else {
        frontSide.classList.add('opacity-0', 'pointer-events-none');
        backSide.classList.remove('opacity-0', 'pointer-events-none');

        btnBack.classList.add('bg-accent-himalaya', 'text-white', 'font-semibold', 'shadow-xs');
        btnBack.classList.remove('text-text-muted');
        btnFront.classList.remove('bg-accent-himalaya', 'text-white', 'font-semibold', 'shadow-xs');
        btnFront.classList.add('text-text-muted');
      }
    }

    btnFront.addEventListener('click', (e) => {
      e.stopPropagation();
      updateCardView(true);
    });

    btnBack.addEventListener('click', (e) => {
      e.stopPropagation();
      updateCardView(false);
    });

    flipper.addEventListener('click', () => {
      updateCardView(!showingFront);
    });
  }

  setupBusinessCard();
  document.addEventListener('astro:page-load', setupBusinessCard);
</script>
