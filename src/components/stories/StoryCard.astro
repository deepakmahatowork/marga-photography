---
interface Story {
  id: string;
  data: {
    title: string;
    subtitle: string;
    photographer: string;
    location: string;
    date: string;
    heroImage: string;
    category: string;
    excerpt: string;
  };
}

interface Props {
  story: Story;
}

const { story } = Astro.props;
const s = story.data;
const slug = story.id.replace(/\.(md|mdx|json)$/, '');
---

<article class="group bg-canvas-elevated border border-canvas-border rounded-lg overflow-hidden flex flex-col card-hover-border">
  <a href={`/stories/${slug}`} class="block relative aspect-[16/10] overflow-hidden">
    <img
      src={s.heroImage}
      alt={s.title}
      loading="lazy"
      decoding="async"
      class="w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-105"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-black/20"></div>
    <div class="absolute top-4 left-4">
      <span class="inline-block px-3 py-1 bg-black/75 backdrop-blur-md border border-white/15 rounded text-[10px] tracking-[0.2em] uppercase font-semibold text-accent-himalaya">
        {s.category}
      </span>
    </div>
  </a>

  <div class="p-6 flex-grow flex flex-col justify-between">
    <div>
      <div class="text-[11px] tracking-[0.2em] text-text-muted uppercase font-sans mb-1.5">
        {s.location} • Photo Essay
      </div>
      <h3 class="font-editorial text-2xl font-medium text-text-primary group-hover:text-accent-himalaya transition-colors leading-snug">
        <a href={`/stories/${slug}`}>
          {s.title}
        </a>
      </h3>
      <p class="text-xs text-text-secondary mt-2 line-clamp-3 leading-relaxed">
        {s.excerpt}
      </p>
    </div>

    <div class="mt-6 pt-4 border-t border-canvas-border flex items-center justify-between text-xs text-text-muted">
      <span>By <strong class="text-text-primary font-medium">{s.photographer}</strong></span>
      <a
        href={`/stories/${slug}`}
        class="text-accent-himalaya hover:text-text-primary uppercase tracking-widest text-[11px] font-semibold flex items-center gap-1 group/btn transition-colors"
      >
        Read Essay
        <span class="transition-transform group-hover/btn:translate-x-1">→</span>
      </a>
    </div>
  </div>
</article>
