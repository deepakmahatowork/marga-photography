---
interface Slide {
  id: string;
  title: string;
  scriptQuote: string;
  subtitle: string;
  description: string;
  location: string;
  image: string;
  bgImage: string;
}

const slides: Slide[] = [
  {
    id: 'slide-1',
    title: 'THE APPRENTICE',
    scriptQuote: 'Because feeling is the finest luxury',
    subtitle: 'Ancestral animist trances in the Western Highlands',
    description: 'In the remote highland valleys of Western Nepal, the boundary between the unseen and the physical dissolves into sacred ritual, resonant drumming, and hypnotic trance.',
    location: 'KHAM MAGAR · WESTERN NEPAL',
    image: '/images/new_uploads/shaman_1.jpg',
    bgImage: '/images/new_uploads/shaman_1.jpg',
  },
  {
    id: 'slide-2',
    title: 'LIVING ANCESTORS',
    scriptQuote: 'Where time slows and the ancient awakens',
    subtitle: 'The wisdom of unbroken generations',
    description: 'Marked with the soot of sacred fires, elders carry the spiritual weight of their communities. Every line on their face tells a story of survival, devotion, and communion with the mountains.',
    location: 'HIGHLAND SHAMAN · NEPAL',
    image: '/images/new_uploads/shaman_2.jpg',
    bgImage: '/images/new_uploads/shaman_2.jpg',
  },
  {
    id: 'slide-3',
    title: 'SACRED BOTANICALS',
    scriptQuote: 'Harnessing the spirit of the forest',
    subtitle: 'Leaves, feathers, and the natural world',
    description: 'Shamanic dress is entirely sourced from the harsh landscape. Peacock feathers to channel the divine, and sacred foliage to bridge the gap between human frailty and natural medicine.',
    location: 'SHAMANIC HEALER · NEPAL',
    image: '/images/new_uploads/shaman_3.jpg',
    bgImage: '/images/new_uploads/shaman_3.jpg',
  },
  {
    id: 'slide-4',
    title: 'RITUAL JUBILEE',
    scriptQuote: 'Light and sound stripped of noise',
    subtitle: 'The entire village gathers in celebration',
    description: 'A shamanic ritual is not a solitary event; it is the heartbeat of the village. Heavy drums, laughter, and communal joy echo through the steep, terraced valleys.',
    location: 'RURAL VILLAGE · NEPAL',
    image: '/images/new_uploads/shaman_4.jpg',
    bgImage: '/images/new_uploads/shaman_4.jpg',
  },
];
---

<!-- ╔══════════════════════════════════════════════════════════
     EXPERIENTIAL SHOWCASE — Editorial Split Layout
     Full-bleed photograph left · Text panel right
     Clip-path slide transitions · Cormorant Garamond italic quotes
     ══════════════════════════════════════════════════════════ -->

<section
  id="experiential-showcase"
  class="relative min-h-[100vh] section-dark overflow-hidden select-none"
  aria-label="Experiential Photography Showcase"
>
  <!-- Subtle background texture from bgImage (very low opacity) -->
  <div class="absolute inset-0 z-0 pointer-events-none overflow-hidden">
    {slides.map((slide, index) => (
      <div
        class={`showcase-bg-layer absolute inset-0 transition-opacity duration-1000 ease-out ${index === 0 ? 'opacity-20' : 'opacity-0'}`}
        data-bg-index={index}
      >
        <img
          src={slide.bgImage}
          alt=""
          class="w-full h-full object-cover filter blur-[3px] brightness-[0.4] scale-105"
          loading="lazy"
          aria-hidden="true"
        />
      </div>
    ))}
    <div class="absolute inset-0 pointer-events-none" style="background: linear-gradient(to right, rgba(8, 8, 10, 0.95) 0%, transparent 40%, rgba(8, 8, 10, 0.7) 100%);"></div>
  </div>

  <div class="relative z-10 h-full min-h-[100vh] flex flex-col">

    <!-- Section header label -->
    <div class="px-6 sm:px-10 md:px-16 pt-20 sm:pt-24 flex items-center gap-4">
      <span class="w-6 h-px bg-[var(--marga-gold)]"></span>
      <span class="journal-label text-[var(--marga-gold)] text-xs">Experiential Field Work</span>
    </div>

    <!-- Main split layout -->
    <div class="flex-1 flex flex-col lg:flex-row items-stretch min-h-0">

      <!-- LEFT: Full-bleed photograph (65% desktop) -->
      <div class="relative w-full lg:w-[60%] h-[55vw] sm:h-[65vw] lg:h-auto min-h-[400px] overflow-hidden">
        {slides.map((slide, index) => (
          <div
            class={`showcase-slide-img absolute inset-0 ${index === 0 ? 'opacity-100' : 'opacity-0'}`}
            data-img-index={index}
            style={index === 0 ? 'clip-path: inset(0 0% 0 0)' : 'clip-path: inset(0 100% 0 0)'}
          >
            <img
              src={slide.image}
              alt={slide.title}
              class="w-full h-full object-cover"
              loading={index === 0 ? 'eager' : 'lazy'}
              decoding="async"
            />
            <!-- Subtle right edge fade -->
            <div class="absolute inset-0 pointer-events-none lg:hidden" style="background: var(--overlay-cinematic);"></div>
          </div>
        ))}

        <!-- Image counter — absolute bottom-left -->
        <div class="absolute bottom-6 left-6 z-20 font-sans text-xs tracking-[0.3em] text-white/40 uppercase" id="showcase-counter">
          01 / 04
        </div>

        <!-- Location badge — absolute bottom-right -->
        <div class="absolute bottom-6 right-6 z-20 text-right hidden lg:block">
          <span class="journal-label text-[0.56rem] text-white/35 block" id="showcase-location-img">{slides[0].location}</span>
        </div>
      </div>

      <!-- RIGHT: Text panel (35% desktop) -->
      <div class="relative w-full lg:w-[40%] flex flex-col justify-center px-8 sm:px-12 lg:px-14 xl:px-16 py-14 lg:py-20 space-y-8 bg-[#0a0a0a]/0">

        <!-- Slide content panels -->
        <div class="relative min-h-[280px] sm:min-h-[320px]">
          {slides.map((slide, index) => (
            <div
              class={`showcase-content absolute inset-0 flex flex-col justify-center space-y-6 transition-all duration-600 ease-out ${
                index === 0 ? 'opacity-100 translate-y-0 pointer-events-auto' : 'opacity-0 translate-y-5 pointer-events-none'
              }`}
              data-content-index={index}
            >
              <!-- Large italic Cormorant quote -->
              <p class="font-editorial text-[clamp(1.5rem,3vw,2.4rem)] font-light italic text-white/90 leading-[1.2] tracking-[-0.01em]">
                &ldquo;{slide.scriptQuote}&rdquo;
              </p>

              <!-- Location label -->
              <div class="flex items-center gap-3">
                <span class="w-5 h-px bg-[var(--marga-gold)]"></span>
                <span class="font-sans text-xs tracking-[0.28em] uppercase text-[var(--marga-gold)]">{slide.location}</span>
              </div>

              <!-- Title -->
              <h3 class="font-editorial text-[clamp(1.5rem,2.5vw,2.2rem)] font-medium text-white tracking-[-0.01em]">
                {slide.title}
              </h3>

              <!-- Description -->
              <p class="font-sans text-[0.78rem] font-light text-white/55 leading-[1.75] max-w-sm">
                {slide.description}
              </p>

              <!-- CTA -->
              <div class="pt-2">
                <a href="/expeditions" class="snami-arrow-link text-[var(--marga-gold)] hover:text-white">
                  <span>Experience</span>
                  <span class="arrow-line"></span>
                </a>
              </div>
            </div>
          ))}
        </div>

        <!-- Navigation controls -->
        <div class="flex items-center justify-between pt-8 border-t border-white/7">
          <!-- Dot indicators -->
          <div class="flex items-center gap-2.5" id="showcase-dots">
            {slides.map((_, index) => (
              <button
                type="button"
                class={`showcase-dot h-px rounded-none transition-all duration-500 cursor-pointer
                  ${index === 0 ? 'w-10 bg-[var(--marga-gold)]' : 'w-4 bg-white/20 hover:bg-white/40'}`}
                data-dot-index={index}
                aria-label={`Slide ${index + 1}`}
              />
            ))}
          </div>

          <!-- Arrow buttons -->
          <div class="flex items-center gap-3">
            <button
              type="button"
              id="showcase-prev-btn"
              class="snami-wire-arrow !w-10 !h-10"
              aria-label="Previous slide"
            >
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.4">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 12H5m0 0l7 7m-7-7l7-7" />
              </svg>
            </button>
            <button
              type="button"
              id="showcase-next-btn"
              class="snami-wire-arrow !w-10 !h-10"
              aria-label="Next slide"
            >
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.4">
                <path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14m0 0l-7-7m7 7l-7 7" />
              </svg>
            </button>
          </div>
        </div>

      </div>
    </div>
  </div>
</section>

<script>
  function setupShowcase() {
    const slideImgs   = document.querySelectorAll('.showcase-slide-img');
    const contents    = document.querySelectorAll('.showcase-content');
    const bgLayers    = document.querySelectorAll('.showcase-bg-layer');
    const dots        = document.querySelectorAll('.showcase-dot');
    const prevBtn     = document.getElementById('showcase-prev-btn');
    const nextBtn     = document.getElementById('showcase-next-btn');
    const counter     = document.getElementById('showcase-counter');
    const locationImg = document.getElementById('showcase-location-img');

    if (!slideImgs.length) return;

    const totalSlides = slideImgs.length;
    let currentIndex  = 0;
    let isAnimating   = false;

    const locations = [
      'KHAM MAGAR · WESTERN NEPAL',
      'BHAKTAPUR · KATHMANDU VALLEY',
      'BARDIA NATIONAL PARK · TERAI',
      'GOKYO RI · SOLUKHUMBU',
    ];

    function goToSlide(index: number) {
      if (isAnimating) return;
      if (index < 0) index = totalSlides - 1;
      if (index >= totalSlides) index = 0;
      if (index === currentIndex) return;

      isAnimating = true;
      const prev  = currentIndex;
      currentIndex = index;

      // Image: clip-path wipe
      const prevImg = slideImgs[prev] as HTMLElement;
      const nextImg = slideImgs[currentIndex] as HTMLElement;

      // Set next behind
      nextImg.style.clipPath = 'inset(0 100% 0 0)';
      nextImg.style.opacity  = '1';
      nextImg.style.zIndex   = '2';
      prevImg.style.zIndex   = '1';

      requestAnimationFrame(() => {
        nextImg.style.transition = 'clip-path 0.85s cubic-bezier(0.76, 0, 0.24, 1)';
        nextImg.style.clipPath   = 'inset(0 0% 0 0)';
      });

      // Content fade
      const prevContent = contents[prev] as HTMLElement;
      const nextContent = contents[currentIndex] as HTMLElement;

      prevContent.style.opacity   = '0';
      prevContent.style.transform = 'translateY(-10px)';
      prevContent.classList.add('pointer-events-none');
      prevContent.classList.remove('pointer-events-auto');

      setTimeout(() => {
        nextContent.style.opacity   = '1';
        nextContent.style.transform = 'translateY(0)';
        nextContent.classList.remove('pointer-events-none');
        nextContent.classList.add('pointer-events-auto');
      }, 250);

      // Background
      bgLayers.forEach((bg, i) => {
        (bg as HTMLElement).style.opacity = i === currentIndex ? '0.20' : '0';
      });

      // Counter & location
      if (counter) {
        counter.textContent = `0${currentIndex + 1} / 0${totalSlides}`;
      }
      if (locationImg) {
        locationImg.textContent = locations[currentIndex] ?? '';
      }

      // Dots
      dots.forEach((dot, i) => {
        if (i === currentIndex) {
          (dot as HTMLElement).style.width = '2.5rem';
          dot.classList.add('bg-[var(--marga-gold)]');
          dot.classList.remove('bg-white/20');
        } else {
          (dot as HTMLElement).style.width = '1rem';
          dot.classList.remove('bg-[var(--marga-gold)]');
          dot.classList.add('bg-white/20');
        }
      });

      setTimeout(() => {
        prevImg.style.opacity  = '0';
        prevImg.style.clipPath = 'inset(0 0 0 100%)';
        prevImg.style.zIndex   = '0';
        prevImg.style.transition = '';
        isAnimating = false;
      }, 900);
    }

    prevBtn?.addEventListener('click', () => goToSlide(currentIndex - 1));
    nextBtn?.addEventListener('click', () => goToSlide(currentIndex + 1));

    dots.forEach((dot) => {
      dot.addEventListener('click', () => {
        const idx = Number(dot.getAttribute('data-dot-index'));
        if (!isNaN(idx)) goToSlide(idx);
      });
    });

    // Touch swipe
    const section = document.getElementById('experiential-showcase');
    let startX = 0;
    section?.addEventListener('touchstart', (e) => { startX = e.changedTouches[0].screenX; }, { passive: true });
    section?.addEventListener('touchend', (e) => {
      const dx = e.changedTouches[0].screenX - startX;
      if (Math.abs(dx) > 50) goToSlide(currentIndex + (dx < 0 ? 1 : -1));
    }, { passive: true });

    // Auto-advance
    let autoTimer = setInterval(() => goToSlide(currentIndex + 1), 7000);
    section?.addEventListener('mouseenter', () => clearInterval(autoTimer));
    section?.addEventListener('mouseleave', () => {
      clearInterval(autoTimer);
      autoTimer = setInterval(() => goToSlide(currentIndex + 1), 7000);
    });
  }

  setupShowcase();
  document.addEventListener('astro:page-load', setupShowcase);
</script>
