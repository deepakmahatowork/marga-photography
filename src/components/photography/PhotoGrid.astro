---
interface Photograph {
  id: string;
  data: {
    title: string;
    category: string;
    location: string;
    image: string;
    photographer: string;
    caption: string;
    aspectRatio: string;
    camera?: string;
    lens?: string;
    focalLength?: string;
    aperture?: string;
    shutterSpeed?: string;
    iso?: string;
    copyright: string;
  };
}

interface Props {
  photos: Photograph[];
  columns?: '2' | '3' | 'mixed';
}

const { photos, columns = 'mixed' } = Astro.props;
---

<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8">
  {photos.map((photo, index) => {
    const p = photo.data;
    const exifString = [
      p.camera,
      p.lens,
      p.focalLength,
      p.aperture,
      p.shutterSpeed,
      p.iso ? `ISO ${p.iso}` : null,
    ]
      .filter(Boolean)
      .map((item) => `<span>${item}</span>`)
      .join('<span class="opacity-40">•</span>');

    const aspectClass =
      p.aspectRatio === 'portrait'
        ? 'aspect-[3/4]'
        : p.aspectRatio === 'square'
        ? 'aspect-square'
        : 'aspect-[16/10]';

    return (
      <figure
        class="group relative overflow-hidden rounded-lg bg-canvas-elevated border border-canvas-border cursor-pointer card-hover-border focus-within:ring-2 focus-within:ring-accent-himalaya"
        data-lightbox-trigger
        data-src={p.image}
        data-title={p.title}
        data-location={p.location}
        data-caption={p.caption}
        data-exif={exifString}
        data-credit={p.copyright}
        tabindex="0"
        role="button"
        aria-label={`View photograph: ${p.title} in fullscreen`}
      >
        <div class={`w-full ${aspectClass} overflow-hidden`}>
          <img
            src={p.image}
            alt={p.title}
            loading={index < 2 ? 'eager' : 'lazy'}
            decoding="async"
            class="w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-105"
          />
        </div>

        <!-- Refined Gradient Overlay on Hover -->
        <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/35 to-transparent opacity-0 group-hover:opacity-100 group-focus:opacity-100 transition-opacity duration-300 flex flex-col justify-end p-5 text-white">
          <span class="text-[10px] tracking-[0.25em] text-accent-himalaya uppercase font-sans mb-1 drop-shadow-sm">
            {p.location}
          </span>
          <h3 class="font-editorial text-lg sm:text-xl text-white font-medium leading-snug drop-shadow-sm">
            {p.title}
          </h3>
          <p class="text-xs text-neutral-200 mt-1 line-clamp-2 leading-relaxed">
            {p.caption}
          </p>

          <div class="mt-3 pt-2 border-t border-white/15 flex items-center justify-between text-[11px] text-neutral-300">
            <span>{p.photographer}</span>
            {p.camera && (
              <span class="font-mono text-[10px] text-accent-himalaya bg-black/60 px-2 py-0.5 rounded border border-white/10">
                {p.camera}
              </span>
            )}
          </div>
        </div>
      </figure>
    );
  })}
</div>
