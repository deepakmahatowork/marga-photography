---
interface BreadcrumbItem {
  name: string;
  url: string;
}

interface Props {
  title: string;
  description: string;
  image?: string;
  canonicalURL?: string;
  type?: 'website' | 'article' | 'product';
  jsonLd?: Record<string, any>;
  breadcrumbs?: BreadcrumbItem[];
}

const {
  title,
  description,
  image = '/images/gokyo_himalaya_sunrise.jpg',
  canonicalURL,
  type = 'website',
  jsonLd,
  breadcrumbs,
} = Astro.props;

const siteUrl = Astro.site?.toString().replace(/\/$/, '') || 'https://margaphotography.com';
const pathname = Astro.url.pathname;
const normalizedPath = pathname.startsWith('/') ? pathname : `/${pathname}`;
const enCanonical = new URL(normalizedPath, siteUrl).href;
const activeCanonical = canonicalURL || enCanonical;

const siteName = 'Marga Photography | Specialist Nepal Expeditions';
const fullTitle = title.includes('Marga Photography') ? title : `${title} — Marga Photography`;
const resolvedImage = new URL(image, siteUrl).href;

const defaultOrgSchema = {
  '@context': 'https://schema.org',
  '@type': ['TravelAgency', 'Organization'],
  name: 'Marga Photography',
  legalName: 'Marga Adventure Pvt. Ltd.',
  url: siteUrl,
  logo: `${siteUrl}/images/marga_photography_logo.png`,
  image: resolvedImage,
  description: 'Specialist photography expeditions into the people, cultures, festivals, wildlife, and landscapes of Nepal.',
  telephone: '+977-9841008984',
  email: 'expeditions@margaphotography.com',
  priceRange: '$$$',
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Kathmandu',
    addressRegion: 'Bagmati',
    addressCountry: 'NP'
  },
  founder: {
    '@type': 'Person',
    name: 'Buddhiman Tamang',
    jobTitle: 'CEO & Expedition Lead'
  },
  parentOrganization: {
    '@type': 'Organization',
    name: 'Marga Adventure',
    url: 'https://margaadventure.com'
  },
  sameAs: [
    'https://instagram.com/margaphotography',
    'https://margaadventure.com'
  ],
};

const breadcrumbSchema = breadcrumbs && breadcrumbs.length > 0 ? {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: breadcrumbs.map((crumb, idx) => ({
    '@type': 'ListItem',
    position: idx + 1,
    name: crumb.name,
    item: crumb.url.startsWith('http') ? crumb.url : new URL(crumb.url, siteUrl).href
  }))
} : null;
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<link rel="icon" type="image/png" href="/images/marga_photography_logo.png" />
<link rel="apple-touch-icon" href="/images/marga_photography_logo.png" />
<link rel="shortcut icon" href="/images/marga_photography_logo.png" />
<meta name="generator" content={Astro.generator} />

<!-- Canonical URL -->
<link rel="canonical" href={activeCanonical} />

<!-- Multi-Language Hreflang Alternates (SEO i18n) -->
<link rel="alternate" hreflang="en" href={enCanonical} />
<link rel="alternate" hreflang="x-default" href={enCanonical} />

<!-- Primary Search Engine & Crawler Directives -->
<title>{fullTitle}</title>
<meta name="title" content={fullTitle} />
<meta name="description" content={description} />
<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
<meta name="googlebot" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
<meta name="bingbot" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
<meta name="keywords" content="Nepal photography expeditions, Himalayan landscape photography, Upper Mustang Tiji festival photo tour, Bengal tiger wildlife photography Nepal, Kathmandu documentary portraits workshop, Sherpa culture photography" />
<meta name="author" content="Marga Photography" />
<meta name="theme-color" content="#0b0f19" />

<!-- Geographic Target Directives (Kathmandu / Himalaya, Nepal) -->
<meta name="geo.region" content="NP" />
<meta name="geo.placename" content="Kathmandu, Nepal" />
<meta name="geo.position" content="27.7172;85.3240" />
<meta name="ICBM" content="27.7172, 85.3240" />

<!-- Open Graph / Facebook -->
<meta property="og:type" content={type} />
<meta property="og:url" content={activeCanonical} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:image" content={resolvedImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={fullTitle} />
<meta property="og:site_name" content={siteName} />
<meta property="og:locale" content="en_US" />

<!-- Twitter / X -->
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={activeCanonical} />
<meta property="twitter:title" content={fullTitle} />
<meta property="twitter:description" content={description} />
<meta property="twitter:image" content={resolvedImage} />
<meta property="twitter:image:alt" content={fullTitle} />

<!-- Google Fonts Preconnect -->
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link
  href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;0,700;1,300;1,400;1,600&family=Plus+Jakarta+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400&family=JetBrains+Mono:ital,wght@0,400;0,500;1,400&display=swap"
  rel="stylesheet"
/>

<!-- Structured Data (JSON-LD) -->
<script type="application/ld+json" is:inline set:html={JSON.stringify(defaultOrgSchema)} />
{breadcrumbSchema && <script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumbSchema)} />}
{jsonLd && <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />}
