---
import BaseLayout from '../../layouts/BaseLayout.astro';
import InquiryForm from '../../components/forms/InquiryForm.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const expeditions = await getCollection('expeditions');
  return expeditions.map((exp) => ({
    params: { slug: exp.id.replace(/\.(md|mdx|json)$/, '') },
    props: { expedition: exp },
  }));
}

const { expedition } = Astro.props;
const exp = expedition.data;
const { Content } = await render(expedition);

const siteUrl = Astro.site?.toString().replace(/\/$/, '') || 'https://margaphotography.com';

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Expeditions', url: '/expeditions' },
  { name: exp.title, url: Astro.url.pathname },
];

const tripJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'TouristTrip',
  name: exp.title,
  description: exp.tagline,
  image: new URL(exp.heroImage, siteUrl).href,
  touristType: 'Photographers, visual artists, documentary filmmakers',
  provider: {
    '@type': 'TravelAgency',
    name: 'Marga Photography',
    url: siteUrl,
  },
  itinerary: exp.itinerary.map((item) => ({
    '@type': 'Day',
    name: `Day ${item.day}: ${item.title}`,
    description: `${item.description} Photography Focus: ${item.photoFocus}`,
  })),
  offers: {
    '@type': 'Offer',
    priceCurrency: 'USD',
    availability: 'https://schema.org/InStock',
    url: Astro.url.href,
  },
};
---

<BaseLayout
  title={`${exp.title} | Nepal Photography Expedition`}
  description={exp.tagline}
  image={exp.heroImage}
  type="product"
  breadcrumbs={breadcrumbs}
  jsonLd={tripJsonLd}
  transparentHeader={true}
>
  <!-- 1. EXPEDITION HERO -->
  <header class="relative min-h-[70vh] flex items-end overflow-hidden pb-16">
    <div class="absolute inset-0 z-0">
      <img
        src={exp.heroImage}
        alt={exp.title}
        fetchpriority="high"
        decoding="async"
        class="w-full h-full object-cover object-center"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/50 to-black/30"></div>
    </div>

    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full">
      <div class="max-w-4xl">
        <div class="flex flex-wrap items-center gap-2 mb-4">
          <span class="px-3 py-1 bg-black/75 backdrop-blur-md border border-white/15 rounded text-[10px] uppercase tracking-[0.2em] font-semibold text-accent-himalaya">
            {exp.category}
          </span>
          <span class="text-xs text-neutral-200 font-sans tracking-wider uppercase">
            {exp.region}
          </span>
        </div>
        <h1 class="font-editorial text-3xl sm:text-5xl lg:text-6xl font-medium text-white leading-tight">
          {exp.title}
        </h1>
        <p class="text-base sm:text-lg text-neutral-200 mt-4 leading-relaxed max-w-3xl font-light drop-shadow-sm">
          {exp.tagline}
        </p>

        <!-- Quick Facts Bar -->
        <div class="mt-8 grid grid-cols-2 sm:grid-cols-4 gap-4 p-4 rounded-lg bg-black/70 backdrop-blur-md border border-white/15 text-xs text-white">
          <div>
            <span class="block text-neutral-400 text-[10px] uppercase tracking-wider">Duration</span>
            <span class="text-white font-medium">{exp.durationDays} Days</span>
          </div>
          <div>
            <span class="block text-neutral-400 text-[10px] uppercase tracking-wider">Group Limit</span>
            <span class="text-white font-medium">{exp.groupSize}</span>
          </div>
          <div>
            <span class="block text-neutral-400 text-[10px] uppercase tracking-wider">Skill Level</span>
            <span class="text-white font-medium">{exp.photographyLevel}</span>
          </div>
          <div>
            <span class="block text-neutral-400 text-[10px] uppercase tracking-wider">Best Season</span>
            <span class="text-white font-medium">{exp.bestSeason}</span>
          </div>
        </div>
      </div>
    </div>
  </header>

  <!-- 2. EXPEDITION DETAILS & ITINERARY -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 sm:py-24">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16">
      
      <!-- Left Column: Itinerary, Photographic Focus, Equipment -->
      <div class="lg:col-span-8 space-y-16">
        
        <!-- Overview Narrative -->
        <div>
          <span class="text-xs uppercase tracking-[0.2em] text-accent-himalaya font-semibold">
            Visual Curatorial Notes
          </span>
          <h2 class="font-editorial text-3xl text-text-primary font-medium mt-1 mb-6">
            The Journey & Photographic Vision
          </h2>
          <div class="prose max-w-none text-text-secondary text-sm leading-relaxed space-y-4">
            <Content />
          </div>
        </div>

        <!-- Photographic Highlights -->
        <div class="p-8 rounded-xl bg-canvas-elevated border border-canvas-border shadow-sm">
          <h3 class="font-editorial text-2xl text-text-primary font-medium mb-6">
            Key Photographic Opportunities
          </h3>
          <ul class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            {exp.photographicOpportunities.map((opp) => (
              <li class="flex items-start gap-3 text-xs text-text-secondary">
                <span class="text-accent-himalaya shrink-0 mt-0.5 font-bold">✦</span>
                <span class="leading-relaxed">{opp}</span>
              </li>
            ))}
          </ul>
        </div>

        <!-- Day by Day Photo Itinerary -->
        <div id="itinerary-container">
          <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-8">
            <div>
              <span class="text-xs uppercase tracking-[0.2em] text-accent-himalaya font-semibold">
                Field Schedule
              </span>
              <h2 class="font-editorial text-3xl text-text-primary font-medium mt-1">
                Day-by-Day Photographic Itinerary
              </h2>
            </div>
            <!-- Quick Expand/Collapse Toggle -->
            <button
              type="button"
              id="toggle-all-days-btn"
              class="inline-flex items-center gap-2 font-mono text-[11px] uppercase tracking-[0.16em] text-accent-himalaya hover:text-text-primary transition-colors py-1.5 px-3 rounded border border-accent-himalaya/30 hover:border-accent-himalaya/60 bg-canvas-surface self-start sm:self-auto cursor-pointer"
            >
              <span id="toggle-all-text">Expand All</span>
              <svg class="w-3.5 h-3.5 transition-transform duration-300" id="toggle-all-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
              </svg>
            </button>
          </div>

          <div class="space-y-4 relative before:absolute before:inset-0 before:left-3.5 before:w-0.5 before:bg-canvas-border">
            {exp.itinerary.map((day) => (
              <details class="itinerary-day group relative pl-10 cursor-pointer">
                <!-- Timeline dot indicator: pulses when open -->
                <div class="absolute left-2 top-5 w-3.5 h-3.5 rounded-full bg-accent-himalaya border-4 border-canvas-bg transition-transform duration-300 group-open:scale-125 group-open:ring-2 group-open:ring-accent-himalaya/40 z-10"></div>

                <!-- Summary Header (Clean title and chevron when collapsed) -->
                <summary class="list-none select-none p-5 sm:p-6 rounded-lg bg-canvas-elevated border border-canvas-border hover:border-accent-himalaya/40 shadow-xs transition-all duration-300 group-open:rounded-b-none group-open:border-b-transparent">
                  <div class="flex items-center justify-between gap-4">
                    <div class="flex flex-col sm:flex-row sm:items-center gap-2 sm:gap-4 min-w-0">
                      <span class="text-xs font-mono uppercase tracking-widest text-accent-himalaya font-semibold shrink-0">
                        Day {day.day}
                      </span>
                      <h4 class="font-editorial text-lg sm:text-xl text-text-primary font-medium group-hover:text-accent-himalaya transition-colors">
                        {day.title}
                      </h4>
                    </div>

                    <!-- Animated Chevron -->
                    <div class="w-7 h-7 rounded-full bg-canvas-surface border border-canvas-border flex items-center justify-center transition-all duration-300 group-open:rotate-180 group-open:bg-accent-himalaya group-open:text-white group-hover:border-accent-himalaya/50 shrink-0">
                      <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
                      </svg>
                    </div>
                  </div>
                </summary>

                <!-- Expanded Content Body (Focus badge now inside) -->
                <div class="itinerary-content p-5 sm:p-6 rounded-b-lg bg-canvas-elevated border-x border-b border-canvas-border shadow-sm text-xs text-text-secondary leading-relaxed pt-2">
                  <div class="mb-3.5 pb-3 border-b border-canvas-border/70 flex flex-wrap items-center gap-2">
                    <span class="font-mono text-[10px] uppercase tracking-[0.18em] text-accent-himalaya font-semibold shrink-0">
                      Photographic Focus:
                    </span>
                    <span class="text-[11px] text-text-primary font-sans bg-canvas-surface border border-canvas-border px-2.5 py-0.5 rounded font-normal">
                      {day.photoFocus}
                    </span>
                  </div>
                  <p class="leading-relaxed text-sm text-text-secondary font-normal">
                    {day.description}
                  </p>
                </div>
              </details>
            ))}
          </div>
        </div>

        <!-- Recommended Gear -->
        <div class="p-8 rounded-xl bg-canvas-elevated border border-canvas-border shadow-sm">
          <h3 class="font-editorial text-2xl text-text-primary font-medium mb-2">
            Recommended Camera Equipment
          </h3>
          <p class="text-xs text-text-muted mb-6">
            Tested in the field. Our expedition vehicles and porters are dedicated to transporting your professional optics safely.
          </p>
          <ul class="space-y-2.5">
            {exp.equipmentRecommendations.map((gear) => (
              <li class="flex items-center gap-3 text-xs text-text-secondary">
                <svg class="w-4 h-4 text-accent-himalaya shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z" />
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 13a3 3 0 11-6 0 3 3 0 016 0z" />
                </svg>
                <span>{gear}</span>
              </li>
            ))}
          </ul>
        </div>

        <!-- Inclusions & Exclusions -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-8 pt-8 border-t border-canvas-border">
          <div>
            <h4 class="text-xs uppercase tracking-[0.2em] text-text-primary font-semibold mb-4">
              What Is Included
            </h4>
            <ul class="space-y-2 text-xs text-text-secondary">
              {exp.included.map((inc) => (
                <li class="flex items-start gap-2">
                  <span class="text-emerald-500 shrink-0">✓</span>
                  <span>{inc}</span>
                </li>
              ))}
            </ul>
          </div>
          <div>
            <h4 class="text-xs uppercase tracking-[0.2em] text-text-primary font-semibold mb-4">
              What Is Excluded
            </h4>
            <ul class="space-y-2 text-xs text-text-muted">
              {exp.excluded.map((exc) => (
                <li class="flex items-start gap-2">
                  <span class="text-text-muted shrink-0">✕</span>
                  <span>{exc}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>

      </div>

      <!-- Right Column: Sticky Inquiry Box -->
      <div class="lg:col-span-4 space-y-8">
        <div class="sticky top-28 space-y-6">
          <div class="p-6 rounded-xl bg-canvas-elevated border border-canvas-border text-center shadow-lg">
            <span class="text-[10px] uppercase tracking-widest text-text-muted">Expedition Status</span>
            <div class="font-editorial text-2xl text-accent-himalaya font-medium my-2">
              Departures Open
            </div>
            <p class="text-xs text-text-secondary mb-6 leading-relaxed">
              Includes restricted permits, domestic flights, 4x4 vehicles, boutique accommodations & masterclass tuition.
            </p>
            <a
              href="#inquire"
              class="block w-full py-3.5 px-6 bg-accent-himalaya hover:bg-brand-dark text-white font-semibold text-xs uppercase tracking-[0.2em] rounded-full transition-all shadow-md text-center"
            >
              Request Expedition Seat
            </a>
            <p class="text-[10px] text-text-muted mt-3">
              Strictly 4 to 6 photographers per departure.
            </p>
          </div>

          <!-- Sister Brand Assurance -->
          <div class="p-5 rounded-lg bg-canvas-surface border border-canvas-border text-xs text-text-secondary space-y-2 shadow-sm">
            <div class="text-text-primary font-medium flex items-center gap-2">
              <svg class="w-4 h-4 text-accent-himalaya" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
              </svg>
              Logistical Guarantee
            </div>
            <p>
              Operated with the full backing of Marga Adventure's licensed mountain rescue protocols and high-altitude emergency networks.
            </p>
          </div>
        </div>
      </div>

    </div>

    <!-- Inquiry Anchor -->
    <div class="mt-24 pt-16 border-t border-canvas-border" id="inquire">
      <div class="max-w-4xl mx-auto">
        <InquiryForm expeditionTitle={exp.title} />
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  summary::-webkit-details-marker,
  summary::marker {
    display: none;
    content: "";
  }
</style>

<script>
  function setupItineraryAccordion() {
    const toggleBtn = document.getElementById('toggle-all-days-btn');
    const toggleText = document.getElementById('toggle-all-text');
    const toggleIcon = document.getElementById('toggle-all-icon');
    const days = document.querySelectorAll('.itinerary-day') as NodeListOf<HTMLDetailsElement>;

    if (!toggleBtn || !days.length) return;

    toggleBtn.addEventListener('click', () => {
      const isAnyOpen = Array.from(days).some((d) => d.open);
      days.forEach((d) => {
        d.open = !isAnyOpen;
      });
      if (toggleText) toggleText.textContent = isAnyOpen ? 'Expand All' : 'Collapse All';
      if (toggleIcon) toggleIcon.style.transform = isAnyOpen ? 'rotate(0deg)' : 'rotate(180deg)';
    });

    days.forEach((day) => {
      day.addEventListener('toggle', () => {
        const allOpen = Array.from(days).every((d) => d.open);
        if (toggleText) toggleText.textContent = allOpen ? 'Collapse All' : 'Expand All';
        if (toggleIcon) toggleIcon.style.transform = allOpen ? 'rotate(180deg)' : 'rotate(0deg)';
      });
    });
  }

  setupItineraryAccordion();
  document.addEventListener('astro:page-load', setupItineraryAccordion);
</script>
