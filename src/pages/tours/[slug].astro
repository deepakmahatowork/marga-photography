---
export function getStaticPaths() {
  return [
    {
      params: { slug: 'nepal-photography' },
      props: { destination: '/expeditions', title: 'Nepal Photography Expeditions' },
    },
    {
      params: { slug: 'mustang-tiji-photography' },
      props: { destination: '/expeditions/tiji-festival-upper-mustang', title: 'Mustang Tiji Festival Photography Tour' },
    },
    {
      params: { slug: 'everest-gokyo-photo' },
      props: { destination: '/expeditions/tshechu-festival-sacred-cham-dances', title: 'Tshechu Festival & Sacred Cham Dances' },
    },
    {
      params: { slug: 'wildlife-photography-nepal' },
      props: { destination: '/expeditions/bisket-jatra-festival-nepalese-new-year', title: 'Bisket Jatra Festival & Nepalese New Year' },
    },
    {
      params: { slug: 'shaman-photography-nepal' },
      props: { destination: '/expeditions/sacred-shamans-of-nepal', title: 'Shaman Festival Tour' },
    },
    {
      params: { slug: 'holi-photography-nepal' },
      props: { destination: '/expeditions/holi-festival-photography-tour', title: 'Holi Festival Photography Tour' },
    },
  ];
}

const { destination, title } = Astro.props;
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <title>{`Redirecting to ${title} — Marga Photography`}</title>
  <link rel="canonical" href={`https://margaphotography.com${destination}`} />
  <meta http-equiv="refresh" content={`0;url=${destination}`} />
  <meta name="robots" content="noindex, follow" />
  <script is:inline define:vars={{ destination }}>
    window.location.replace(destination);
  </script>
</head>
<body style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; text-align: center; padding: 40px; background: #0b0f19; color: #f8fafc;">
  <p>Redirecting to <a href={destination} style="color: #1e73be; text-decoration: underline;">{title}</a>...</p>
</body>
</html>
