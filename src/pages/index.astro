---
import BaseLayout from '../layouts/BaseLayout.astro';
import PhotoGrid from '../components/photography/PhotoGrid.astro';
import Lightbox from '../components/photography/Lightbox.astro';
import ExpeditionCard from '../components/expeditions/ExpeditionCard.astro';
import StoryCard from '../components/stories/StoryCard.astro';
import InquiryForm from '../components/forms/InquiryForm.astro';
import { getCollection } from 'astro:content';

const allPhotos = await getCollection('photographs');
const featuredPhotos = allPhotos.filter((p) => p.data.featured);

const allExpeditions = await getCollection('expeditions');
const featuredExpeditions = allExpeditions.filter((e) => e.data.featured);

const allStories = await getCollection('stories');
const featuredStories = allStories.filter((s) => s.data.featured);

const homeJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Marga Photography',
  url: 'https://margaphotography.com',
  description: 'Specialist photography expeditions into the people, cultures, festivals, wildlife, and landscapes of Nepal.',
};
---

<BaseLayout
  title="Specialist Nepal Photography Expeditions & Visual Storytelling"
  description="Marga Photography creates bespoke, masterclass photography expeditions into the people, ancient rituals, living cultures, wildlife, and high Himalayan landscapes of Nepal."
  jsonLd={homeJsonLd}
>
  <!-- 1. PHOTOGRAPHY-FIRST HERO (UNMASKED LIGHT PHOTO) -->
  <section class="relative min-h-[92vh] flex items-end justify-start overflow-hidden pb-12 sm:pb-20">
    <!-- Hero Background Image (Pure Unmasked Photograph) -->
    <div class="absolute inset-0 z-0">
      <img
        src="/images/himalaya_morning_light.jpg"
        alt="Luminous snow-capped Himalayan peaks and alpine river valley in morning daylight"
        fetchpriority="high"
        decoding="async"
        class="w-full h-full object-cover object-center"
      />
    </div>

    <!-- Hero Content in High-End Fine-Art Glass Panel (No Photo Mask) -->
    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full">
      <div class="max-w-2xl p-6 sm:p-10 rounded-2xl glass-panel shadow-2xl border border-canvas-border backdrop-blur-xl">
        <span class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-canvas-surface border border-canvas-border text-accent-himalaya text-[11px] uppercase tracking-[0.25em] font-semibold mb-4">
          <span class="w-1.5 h-1.5 rounded-full bg-accent-himalaya animate-pulse"></span>
          Specialist Nepal Photography
        </span>
        <h1 class="font-editorial text-3xl sm:text-5xl lg:text-6xl font-normal text-text-primary leading-[1.08] tracking-tight">
          Where Sacred Light <br />
          <span class="italic text-accent-himalaya font-light">Meets Living Heritage.</span>
        </h1>
        <p class="mt-4 text-sm sm:text-base text-text-secondary font-light leading-relaxed">
          We don't build generic tours. We lead quiet, small-group visual expeditions into the deep human stories, sacred masked rituals, wild tiger corridors, and alpine sanctuaries of Nepal.
        </p>

        <!-- CTAs -->
        <div class="mt-6 flex flex-col sm:flex-row items-stretch sm:items-center gap-3.5">
          <a
            href="/expeditions"
            class="px-7 py-3.5 bg-accent-himalaya hover:bg-brand-dark text-white font-semibold text-xs uppercase tracking-[0.2em] rounded-full transition-all shadow-md hover:shadow-accent-himalaya/25 text-center justify-center"
          >
            Explore 2026 Expeditions
          </a>
          <a
            href="#portfolio"
            class="px-7 py-3.5 bg-canvas-surface hover:bg-canvas-elevated border border-canvas-border hover:border-accent-himalaya text-text-primary font-medium text-xs uppercase tracking-[0.2em] rounded-full transition-all shadow-sm text-center justify-center"
          >
            View Portfolio
          </a>
        </div>
      </div>
    </div>

    <!-- Bottom Metadata Ribbon -->
    <div class="absolute bottom-4 right-4 sm:right-8 hidden md:flex items-center gap-3 text-[11px] text-text-secondary font-mono glass-panel px-4 py-2 rounded-full border border-canvas-border shadow-sm">
      <span>High Himalaya Sanctuary</span>
      <span class="text-canvas-border">•</span>
      <span>Hasselblad X2D 100C</span>
      <span class="text-canvas-border">•</span>
      <span>f/8 • 1/500s • ISO 64</span>
    </div>
  </section>

  <!-- 2. CORE PORTFOLIOS (PHOTOGRAPHY CURATION) -->
  <section id="portfolio" class="py-24 sm:py-32 bg-canvas-bg border-t border-canvas-border transition-colors duration-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Section Header -->
      <div class="flex flex-col md:flex-row md:items-end justify-between mb-12 sm:mb-16 gap-6">
        <div>
          <span class="text-xs uppercase tracking-[0.25em] text-accent-himalaya font-sans font-semibold">
            Curated Visual Archive
          </span>
          <h2 class="font-editorial text-3xl sm:text-5xl font-medium text-text-primary mt-2">
            The Five Realms of Nepal
          </h2>
        </div>
        <!-- Filter Tabs (Horizontal touch scroll on mobile, flex-wrap on desktop) -->
        <div class="flex items-center gap-2 text-xs uppercase tracking-widest overflow-x-auto no-scrollbar pb-2 -mx-4 px-4 sm:mx-0 sm:px-0 sm:flex-wrap">
          <a href="/explore/people" class="whitespace-nowrap px-4 py-2 rounded-full bg-canvas-surface hover:bg-accent-himalaya hover:text-white transition-colors border border-canvas-border hover:border-accent-himalaya text-text-secondary shadow-xs">
            People
          </a>
          <a href="/explore/culture" class="whitespace-nowrap px-4 py-2 rounded-full bg-canvas-surface hover:bg-accent-himalaya hover:text-white transition-colors border border-canvas-border hover:border-accent-himalaya text-text-secondary shadow-xs">
            Culture
          </a>
          <a href="/explore/festivals" class="whitespace-nowrap px-4 py-2 rounded-full bg-canvas-surface hover:bg-accent-himalaya hover:text-white transition-colors border border-canvas-border hover:border-accent-himalaya text-text-secondary shadow-xs">
            Festivals
          </a>
          <a href="/explore/wildlife" class="whitespace-nowrap px-4 py-2 rounded-full bg-canvas-surface hover:bg-accent-himalaya hover:text-white transition-colors border border-canvas-border hover:border-accent-himalaya text-text-secondary shadow-xs">
            Wildlife
          </a>
          <a href="/explore/landscapes" class="whitespace-nowrap px-4 py-2 rounded-full bg-canvas-surface hover:bg-accent-himalaya hover:text-white transition-colors border border-canvas-border hover:border-accent-himalaya text-text-secondary shadow-xs">
            Landscapes
          </a>
        </div>
      </div>

      <!-- Photo Grid Component -->
      <PhotoGrid photos={featuredPhotos} />

      <div class="mt-12 text-center">
        <a
          href="/explore/people"
          class="inline-flex items-center gap-2 text-xs uppercase tracking-[0.2em] font-semibold text-accent-himalaya hover:text-text-primary transition-colors"
        >
          Explore Complete Photographic Collection
          <span>→</span>
        </a>
      </div>
    </div>
  </section>

  <!-- 3. STORIES FROM THE FIELD (EDITORIAL / CONVERSION) -->
  <section class="py-24 sm:py-32 bg-canvas-surface border-y border-canvas-border transition-colors duration-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col md:flex-row md:items-end justify-between mb-16 gap-6">
        <div>
          <span class="text-xs uppercase tracking-[0.25em] text-accent-himalaya font-sans font-semibold">
            Field Notes & Photo Essays
          </span>
          <h2 class="font-editorial text-3xl sm:text-5xl font-medium text-text-primary mt-2">
            Stories from the Field
          </h2>
        </div>
        <a
          href="/stories"
          class="text-xs uppercase tracking-[0.2em] font-semibold text-text-muted hover:text-text-primary transition-colors"
        >
          All Photo Essays & Journal →
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {featuredStories.map((story) => (
          <StoryCard story={story} />
        ))}
      </div>
    </div>
  </section>

  <!-- 4. THE MARGA METHOD (AUTHORITY PILLAR) -->
  <section class="py-24 sm:py-32 bg-canvas-bg transition-colors duration-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center">
        <div class="lg:col-span-5">
          <span class="text-xs uppercase tracking-[0.25em] text-accent-himalaya font-sans font-semibold">
            Why Marga Photography
          </span>
          <h2 class="font-editorial text-3xl sm:text-5xl font-medium text-text-primary mt-3 leading-tight">
            Photography First. <br />
            <span class="italic text-text-muted font-light">Logistics as Craft.</span>
          </h2>
          <p class="text-text-secondary text-sm sm:text-base leading-relaxed mt-6">
            Most tour operators tack on a photography tag to regular trekking packages. We built Marga Photography as a dedicated visual collective. Every route, timing, lodging, and vehicle is chosen strictly for light, vantage, and uninterrupted focus.
          </p>
          <div class="mt-8 pt-6 border-t border-canvas-border">
            <p class="text-xs text-text-muted leading-relaxed">
              <strong class="text-text-primary">Powered by Marga Adventure:</strong> Our parent company provides battle-tested mountain logistics, helicopter networks, high-clearance 4x4s, and restricted area permit access, allowing our photography leads to focus 100% on mentoring and composition.
            </p>
          </div>
        </div>

        <div class="lg:col-span-7 grid grid-cols-1 sm:grid-cols-2 gap-6">
          <div class="p-6 bg-canvas-elevated border border-canvas-border rounded-lg card-hover-border">
            <span class="font-editorial text-3xl text-accent-himalaya font-medium">01</span>
            <h3 class="text-base font-medium text-text-primary mt-2">Strictly 4–6 Photographers</h3>
            <p class="text-xs text-text-secondary mt-2 leading-relaxed">
              Never fight for tripod space or crowd local communities. Intimate groups ensure unhurried shooting and genuine personal mentorship.
            </p>
          </div>

          <div class="p-6 bg-canvas-elevated border border-canvas-border rounded-lg card-hover-border">
            <span class="font-editorial text-3xl text-accent-himalaya font-medium">02</span>
            <h3 class="text-base font-medium text-text-primary mt-2">Special Restricted Access</h3>
            <p class="text-xs text-text-secondary mt-2 leading-relaxed">
              From Upper Mustang’s walled kingdom to private bronze foundries in Patan, our indigenous network secures permits and cultural trust.
            </p>
          </div>

          <div class="p-6 bg-canvas-elevated border border-canvas-border rounded-lg card-hover-border">
            <span class="font-editorial text-3xl text-accent-himalaya font-medium">03</span>
            <h3 class="text-base font-medium text-text-primary mt-2">Light-Dictated Pacing</h3>
            <p class="text-xs text-text-secondary mt-2 leading-relaxed">
              We shoot before blue hour, rest during harsh midday glare for histogram critique and editing sessions, and resume for sunset and astrophotography.
            </p>
          </div>

          <div class="p-6 bg-canvas-elevated border border-canvas-border rounded-lg card-hover-border">
            <span class="font-editorial text-3xl text-accent-himalaya font-medium">04</span>
            <h3 class="text-base font-medium text-text-primary mt-2">Masterclass Mentorship</h3>
            <p class="text-xs text-text-secondary mt-2 leading-relaxed">
              Led by award-winning Himalayan documentary photographers and wildlife trackers with decades of field-tested expertise.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 5. FLAGSHIP EXPEDITIONS -->
  <section class="py-24 sm:py-32 bg-canvas-surface border-y border-canvas-border transition-colors duration-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col md:flex-row md:items-end justify-between mb-16 gap-6">
        <div>
          <span class="text-xs uppercase tracking-[0.25em] text-accent-himalaya font-sans font-semibold">
            2026 Small-Group Expeditions
          </span>
          <h2 class="font-editorial text-3xl sm:text-5xl font-medium text-text-primary mt-2">
            Flagship Photography Journeys
          </h2>
        </div>
        <a
          href="/expeditions"
          class="text-xs uppercase tracking-[0.2em] font-semibold text-accent-himalaya hover:text-text-primary transition-colors"
        >
          View All Expeditions & Dates →
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {featuredExpeditions.map((exp) => (
          <ExpeditionCard expedition={exp} />
        ))}
      </div>
    </div>
  </section>

  <!-- 6. INQUIRY & CUSTOM TRIP SECTION -->
  <section class="py-24 sm:py-32 bg-canvas-bg transition-colors duration-200" id="inquire">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <InquiryForm />
    </div>
  </section>

  <!-- Lightbox Island -->
  <Lightbox />
</BaseLayout>
