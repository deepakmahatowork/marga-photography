---
import BaseLayout from '../layouts/BaseLayout.astro';
import ExperientialShowcase from '../components/photography/ExperientialShowcase.astro';
import RegionsExplorer from '../components/expeditions/RegionsExplorer.astro';
import ExpeditionCard from '../components/expeditions/ExpeditionCard.astro';
import InquiryForm from '../components/forms/InquiryForm.astro';
import Lightbox from '../components/photography/Lightbox.astro';
import { getCollection } from 'astro:content';

const allPhotos = await getCollection('photographs');
const featuredPhotos = allPhotos.filter((p) => p.data.featured);

const allExpeditions = await getCollection('expeditions');
const featuredExpeditions = allExpeditions.filter((e) => e.data.featured);

const heroSlides = [
  {
    image: '/images/himalaya_dramatic_sunrise.jpg',
    alt: 'Dramatic golden sunrise over the High Himalaya Range in Nepal',
    location: 'KHUMBU · 5,364M',
    tagline: 'High Alpine Light',
  },
  {
    image: '/images/tiji_festival_dance.jpg',
    alt: 'Sacred masked monks dancing at Tiji Festival in Lo Manthang Upper Mustang',
    location: 'UPPER MUSTANG · 3,840M',
    tagline: 'Ancient Tantric Rituals',
  },
  {
    image: '/images/kham_magar_shaman_phephur.jpg',
    alt: 'Kham Magar Shaman in trance with sacred phephur bone flute',
    location: 'WESTERN HIGHLANDS · 2,850M',
    tagline: 'Living Shamanic Heritage',
  },
];

const homeJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Marga Photography',
  url: 'https://margaphotography.com',
  description: 'Specialist masterclass photography expeditions into the sacred rituals, living cultures, wild corridors, and high Himalayan landscapes of Nepal.',
};
---

<BaseLayout
  title="Marga Photography — Luxury Himalayan Photography Expeditions & Visual Storytelling"
  description="Masterclass photography expeditions into sacred rituals, wild tiger corridors, and high Himalayan sanctuaries in Nepal. Strictly 4 to 6 photographers per group."
  jsonLd={homeJsonLd}
>
  <!-- ══════════════════════════════════════════════════════════════
       1. HERO SECTION (100vh) — Snami Travel Exact Visual Composition
       ══════════════════════════════════════════════════════════════ -->
  <section class="relative h-[100dvh] w-full flex flex-col justify-between overflow-hidden bg-[#161616] text-white select-none">
    <!-- Rotating Background Images with Ken-Burns and Crossfade -->
    <div class="absolute inset-0 z-0 overflow-hidden" id="hero-carousel">
      {heroSlides.map((slide, index) => (
        <div
          class={`hero-slide absolute inset-0 transition-opacity duration-1000 ease-in-out ${
            index === 0 ? 'opacity-100 z-10' : 'opacity-0 z-0'
          }`}
          data-hero-slide={index}
        >
          <img
            src={slide.image}
            alt={slide.alt}
            fetchpriority={index === 0 ? 'high' : 'low'}
            loading={index === 0 ? 'eager' : 'lazy'}
            decoding="async"
            class="w-full h-full object-cover filter brightness-[0.72] scale-105 transition-transform duration-[12000ms] ease-out hero-zoom-effect"
          />
        </div>
      ))}
      <!-- Multi-Stop Cinematic Editorial Vignette -->
      <div class="absolute inset-0 z-10 bg-gradient-to-t from-[#161616] via-black/25 to-black/45"></div>
      <div class="absolute inset-0 z-10 bg-radial from-transparent via-[#161616]/30 to-[#161616]/75"></div>
    </div>

    <!-- Hero Top Meta Bar -->
    <div class="relative z-20 flex items-center justify-between px-6 sm:px-12 md:px-16 pt-28 sm:pt-32">
      <div class="flex items-center gap-3">
        <span class="w-1.5 h-1.5 rounded-full bg-[#bea380] animate-ping"></span>
        <span class="text-[10px] sm:text-[11px] uppercase tracking-[0.35em] text-[#bea380] font-mono">
          Kathmandu, Nepal
        </span>
      </div>
      <div class="hidden sm:flex items-center gap-6 text-[10px] sm:text-[11px] uppercase tracking-[0.35em] text-white/50 font-mono">
        <span>5 Years of Field Expertise</span>
        <span class="w-1 h-1 rounded-full bg-white/30"></span>
        <span>4–6 Photographers</span>
      </div>
    </div>

    <!-- Hero Center (Snami Centered Dream Avenue Title + Minimalist Outline Box Button) -->
    <div class="relative z-20 max-w-5xl mx-auto px-6 sm:px-12 w-full text-center my-auto py-12">
      <h1 class="font-dream text-[clamp(2.75rem,7.8vw,6.8rem)] font-light text-white leading-[1.04] tracking-tight uppercase hero-rise">
        Himalayan Storytelling<br />
        <span class="text-[#bea380]">Redefined.</span>
      </h1>

      <p class="text-xs sm:text-sm md:text-base text-white/75 font-light tracking-wide max-w-xl mx-auto mt-6">
        Masterclass photography expeditions into sacred rituals, wild tiger corridors, and remote Himalayan sanctuaries.
      </p>

      <!-- Snami Center Box Outline Button -->
      <div class="pt-8 flex justify-center">
        <a href="#ethos" class="snami-outline-btn">
          <span>Define Your Expedition</span>
        </a>
      </div>
    </div>

    <!-- Bottom Carousel Dots & Scroll -->
    <div class="relative z-20 px-6 sm:px-12 md:px-16 pb-8 flex items-end justify-between">
      <div class="flex items-center gap-2.5" id="hero-dots">
        {heroSlides.map((slide, index) => (
          <button
            type="button"
            class={`hero-dot h-1 rounded-full transition-all duration-500 cursor-pointer ${
              index === 0 ? 'w-8 bg-[#bea380]' : 'w-2.5 bg-white/30 hover:bg-white/60'
            }`}
            data-hero-dot={index}
            aria-label={`Slide ${index + 1}: ${slide.tagline}`}
          />
        ))}
      </div>

      <a
        href="#ethos"
        class="hidden sm:flex flex-col items-center gap-2 group cursor-pointer"
        aria-label="Scroll to content"
      >
        <span class="text-[9px] font-mono uppercase tracking-[0.35em] text-white/40 group-hover:text-[#bea380] transition-colors">
          Scroll
        </span>
        <div class="w-px h-8 bg-gradient-to-b from-white/40 via-[#bea380] to-transparent hero-scroll-pulse"></div>
      </a>

      <div class="text-[10px] font-mono text-white/40 uppercase tracking-[0.25em]">
        27°42' N · 85°19' E
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════════════════════════════
       2. SECTION 1 — "MADE IN THE HIMALAYAS. DEFINED BY LIGHT."
       (Snami 'MADE IN CRETE. DEFINED BY GREECE.' split 50/50 layout)
       ══════════════════════════════════════════════════════════════ -->
  <section id="ethos" class="relative w-full bg-[#161616] text-white overflow-hidden select-none">
    <div class="grid grid-cols-1 lg:grid-cols-2 min-h-[90vh] lg:min-h-[100vh] items-stretch">
      
      <!-- Left 50%: Full-Bleed Image reaching the left screen edge -->
      <div class="relative w-full h-[55vh] lg:h-auto min-h-[400px] overflow-hidden">
        <img
          src="/images/mustang_monk_portrait.jpg"
          alt="Elder Tibetan monk in Upper Mustang monastery"
          loading="lazy"
          decoding="async"
          class="w-full h-full object-cover filter brightness-[0.88] scale-100 hover:scale-105 transition-transform duration-1000 ease-out"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-[#161616] via-transparent to-transparent lg:hidden"></div>
      </div>

      <!-- Right 50%: Dark Background with Giant Title Overlapping the 50% seam -->
      <div class="relative flex flex-col justify-center px-8 sm:px-14 lg:px-20 py-20 lg:py-28 space-y-8 bg-[#161616] z-10">
        
        <!-- Giant Overlapping Dream Avenue Title -->
        <div class="lg:-ml-36 xl:-ml-48 z-20 pointer-events-none">
          <h2 class="font-dream text-[clamp(2.75rem,5.2vw,5.5rem)] font-light text-[#bea380] leading-[1.04] tracking-tight uppercase drop-shadow-[0_4px_24px_rgba(0,0,0,0.7)]">
            Made in the<br />
            Himalayas.<br />
            Defined by<br />
            Light.
          </h2>
        </div>

        <!-- Narrative Copy & Snami Arrow Link -->
        <div class="space-y-6 max-w-lg z-10 pt-2">
          <p class="text-sm sm:text-base text-neutral-300 font-light leading-relaxed">
            Marga was born in the high valleys of Nepal — a land where raw topography meets living spiritual traditions, and the ancient world still shapes everyday life. It’s here that we learned the art of patient observation: the fleeting angle of morning light striking a monastery courtyard, the trance rhythms of mountain shamans, and the silence of the high passes.
          </p>

          <p class="text-sm sm:text-base text-neutral-300 font-light leading-relaxed">
            What began as documentary field craft became an art form: the design of photography journeys that feel as alive and timeless as Nepal itself. We do not herd groups through tourist viewpoints; we orchestrate intimate residencies paced strictly by dawn, twilight, and genuine human connection.
          </p>

          <div class="pt-4">
            <a href="/about" class="snami-arrow-link text-white hover:text-[#bea380]">
              <span>Our Philosophy</span>
              <span class="arrow-line"></span>
            </a>
          </div>
        </div>

      </div>

    </div>
  </section>

  <!-- ══════════════════════════════════════════════════════════════
       3. SECTION 2 — "FOR THOSE WHO SEE DIFFERENTLY"
       (Snami 'FOR THOSE WHO TRAVEL DIFFERENTLY' dark editorial manifesto)
       ══════════════════════════════════════════════════════════════ -->
  <section class="py-32 sm:py-44 bg-[#161616] text-white border-t border-white/5 relative overflow-hidden select-none">
    <div class="max-w-7xl mx-auto px-6 sm:px-10 lg:px-14">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-14 items-center">
        
        <!-- Left Portrait: Patrick Frilet (Vertical Stagger) -->
        <div class="lg:col-span-3 order-2 lg:order-1 flex flex-col items-center text-center space-y-3 lg:-translate-y-8">
          <div class="w-full aspect-[3/4] max-w-[260px] overflow-hidden shadow-2xl border border-white/10 editorial-img-frame">
            <img
              src="/images/kham_magar_shaman_phephur.jpg"
              alt="Patrick Frilet — Documentary Mentor"
              loading="lazy"
              decoding="async"
              class="w-full h-full object-cover"
            />
          </div>
          <div>
            <h4 class="font-dream text-base text-white font-medium uppercase">Patrick Frilet</h4>
            <span class="font-mono text-[9px] uppercase tracking-widest text-[#bea380]">Photojournaliste · Mentor</span>
          </div>
        </div>

        <!-- Center Column: Giant 3-Line Centered Dream Avenue Title + Poetic Manifesto -->
        <div class="lg:col-span-6 order-1 lg:order-2 text-center space-y-8 px-4">
          <h2 class="font-dream text-[clamp(2.75rem,5.5vw,5.5rem)] font-light uppercase text-[#dcd8d0] leading-[1.05] tracking-tight">
            For Those<br />
            Who See<br />
            Differently
          </h2>

          <div class="space-y-4 max-w-lg mx-auto">
            <p class="text-xs sm:text-sm text-neutral-400 font-light leading-relaxed">
              You look for stories, not stops. For emotion, not escape. You notice the smallest details — the way twilight folds over monastery walls, the sudden silence of a courtyard before prayer, the scent of juniper smoke rising through the mist.
            </p>
            <p class="text-xs sm:text-sm text-neutral-400 font-light leading-relaxed">
              You travel not to capture trophies, but to understand. At Marga, we design for that instinct — masterclass journeys that mirror your curiosity, your rhythm, and your devotion to light.
            </p>
          </div>
        </div>

        <!-- Right Portrait: Kham Magar Elder (Vertical Stagger Downwards) -->
        <div class="lg:col-span-3 order-3 flex flex-col items-center text-center space-y-3 lg:translate-y-8">
          <div class="w-full aspect-[3/4] max-w-[260px] overflow-hidden shadow-2xl border border-white/10 editorial-img-frame">
            <img
              src="/images/burtibang_shaman_dhyangro_elder.jpg"
              alt="Senior Shaman Practitioner in Western Highlands"
              loading="lazy"
              decoding="async"
              class="w-full h-full object-cover"
            />
          </div>
          <div>
            <h4 class="font-dream text-base text-white font-medium uppercase">Kham Magar Elder</h4>
            <span class="font-mono text-[9px] uppercase tracking-widest text-[#bea380]">Living Shamanic Lineage</span>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════════════════════════════
       4. SECTION 3 — EXPERIENTIAL SHOWCASE ("WE FRAME EMOTION")
       (Snami 'WE DESIGN EMOTION' central card + cursive script slider)
       ══════════════════════════════════════════════════════════════ -->
  <ExperientialShowcase />

  <!-- ══════════════════════════════════════════════════════════════
       5. SECTION 4 — CURATED COLLECTION (Linen #EBEAE6 Canvas)
       (Snami 'LUXURY HOTELS & VILLAS' staggered architectural layout)
       ══════════════════════════════════════════════════════════════ -->
  <section id="portfolio" class="py-32 sm:py-44 bg-[#EBEAE6] text-[#161616] overflow-hidden select-none">
    <div class="max-w-7xl mx-auto px-6 sm:px-10 lg:px-14">
      
      <!-- Top Section Header & Title Straddling the Seam -->
      <div class="relative">
        <span class="font-sans text-[11px] uppercase tracking-[0.35em] text-[#161616]/60 font-semibold block mb-4">
          CURATED COLLECTION
        </span>

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-start">
          
          <!-- Left: Giant Dream Avenue Title -->
          <div class="lg:col-span-7 z-20">
            <h2 class="font-dream text-[clamp(2.75rem,6vw,5.5rem)] font-light uppercase text-[#161616] leading-[1.04] tracking-tight">
              Masterclass<br />
              Expeditions
            </h2>
          </div>

          <!-- Top-Right: Vertical Framing Image Overlapping Seam -->
          <div class="lg:col-span-5 lg:-mt-12 z-10">
            <div class="w-full aspect-[3/4] max-w-[420px] ml-auto overflow-hidden shadow-xl bg-[#dedcd6] editorial-img-frame">
              <img
                src="/images/bhaktapur_heritage_lamps.jpg"
                alt="Sacred terracotta butter lamps in Bhaktapur"
                loading="lazy"
                decoding="async"
                class="w-full h-full object-cover"
              />
            </div>
          </div>

        </div>
      </div>

      <!-- Lower Staggered Row: Lower-Left Image + Lower-Right Narrative -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 sm:gap-16 items-center mt-12 sm:mt-20">
        
        <!-- Lower Left: Staggered Architecture Frame -->
        <div class="lg:col-span-5">
          <div class="w-full aspect-[3/4] max-w-[360px] overflow-hidden shadow-xl bg-[#dedcd6] editorial-img-frame">
            <img
              src="/images/tiji_festival_dance.jpg"
              alt="Sacred monastic rituals in Upper Mustang"
              loading="lazy"
              decoding="async"
              class="w-full h-full object-cover"
            />
          </div>
        </div>

        <!-- Lower Right: Editorial Story & Link -->
        <div class="lg:col-span-7 space-y-6 max-w-lg lg:pl-10">
          <h3 class="font-dream text-3xl sm:text-4xl text-[#161616] font-light uppercase tracking-tight">
            Sacred Living Sanctuaries
          </h3>

          <p class="text-sm text-[#161616]/70 italic font-serif">
            "Because intimacy always leaves the deepest mark."
          </p>

          <p class="text-xs sm:text-sm text-[#161616]/80 font-light leading-relaxed">
            Here, silence becomes the new indulgence. These masterclass retreats trade scale for soul — strictly 4 to 6 photographers, unhurried dawns, and direct access to hereditary masters. Beauty that doesn't demand attention; it earns it.
          </p>

          <div class="pt-4">
            <a href="/expeditions" class="snami-arrow-link text-[#161616] hover:text-[#bea380]">
              <span>Discover All Expeditions</span>
              <span class="arrow-line"></span>
            </a>
          </div>
        </div>

      </div>

    </div>
  </section>

  <!-- ══════════════════════════════════════════════════════════════
       6. SECTION 5 — 2026 MASTERCLASS FIELD DOSSIERS (Dark #161616)
       (Snami 'DAY TOURS & LUXURY EXPERIENCES' counterpart)
       ══════════════════════════════════════════════════════════════ -->
  <section id="expeditions" class="py-32 sm:py-44 bg-[#161616] text-white border-t border-white/5">
    <div class="max-w-7xl mx-auto px-6 sm:px-10 lg:px-14">
      
      <!-- Section Header -->
      <div class="flex flex-col md:flex-row md:items-end justify-between mb-16 sm:mb-24 gap-6 border-b border-white/10 pb-8">
        <div>
          <span class="font-sans text-[11px] uppercase tracking-[0.35em] text-[#bea380] font-semibold block mb-3">
            FIELD ITINERARIES 2026
          </span>
          <h2 class="font-dream text-3xl sm:text-5xl font-light uppercase text-white tracking-tight">
            Selected Expeditions
          </h2>
          <p class="mt-3 text-xs sm:text-sm text-white/60 font-light max-w-xl">
            Strictly 4 to 6 photographers. Scheduled precisely around sacred seasonal dates and optimum Himalayan light.
          </p>
        </div>

        <a
          href="/expeditions"
          class="snami-arrow-link text-[#bea380] hover:text-white shrink-0"
        >
          <span>All 2026 Expeditions</span>
          <span class="arrow-line"></span>
        </a>
      </div>

      <!-- Expeditions Cards Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 lg:gap-10">
        {featuredExpeditions.map((exp) => (
          <ExpeditionCard expedition={exp} />
        ))}
      </div>

    </div>
  </section>

  <!-- ══════════════════════════════════════════════════════════════
       7. SECTION 6 — DISCOVER SACRED REGIONS
       (Snami 'DISCOVER MORE DESTINATIONS' hover engine)
       ══════════════════════════════════════════════════════════════ -->
  <RegionsExplorer />

  <!-- ══════════════════════════════════════════════════════════════
       8. SECTION 7 — INQUIRY & RESERVATION SECTION (Dark #161616)
       ══════════════════════════════════════════════════════════════ -->
  <section class="py-32 sm:py-40 bg-[#161616] border-t border-white/10 text-white" id="inquire">
    <div class="max-w-4xl mx-auto px-6 sm:px-10 lg:px-12">
      <div class="text-center mb-12">
        <span class="font-sans text-[11px] uppercase tracking-[0.35em] text-[#bea380] font-semibold block mb-3">
          DIRECT DISPATCH
        </span>
        <h2 class="font-dream text-3xl sm:text-5xl font-light uppercase text-white tracking-tight">
          Request an Expedition
        </h2>
        <p class="text-xs sm:text-sm text-white/60 font-light mt-3 max-w-lg mx-auto">
          Due to strict 4–6 group limits, departures fill early. Contact our dispatch desk for private dossiers, custom routes, and commercial rights.
        </p>
      </div>

      <InquiryForm />
    </div>
  </section>

  <!-- Lightbox Modal for High-Resolution Image Inspection -->
  <Lightbox />

</BaseLayout>

<style>
  /* Subtle scroll indicator animation */
  .hero-scroll-pulse {
    animation: scrollPulse 2.2s cubic-bezier(0.4, 0, 0.6, 1) infinite;
  }
  @keyframes scrollPulse {
    0%, 100% { opacity: 0.25; transform: scaleY(0.9); }
    50% { opacity: 0.9; transform: scaleY(1.3); }
  }

  /* Slow Ken-Burns zoom effect for active hero slide */
  .hero-zoom-effect {
    animation: heroZoom 14s ease-out infinite alternate;
  }
  @keyframes heroZoom {
    0% { transform: scale(1.03); }
    100% { transform: scale(1.09); }
  }
</style>

<script>
  function setupHeroCarousel() {
    const slides = document.querySelectorAll('.hero-slide');
    const dots = document.querySelectorAll('.hero-dot');
    if (!slides.length) return;

    let currentIndex = 0;
    const totalSlides = slides.length;
    let timer: number;

    function goToSlide(index: number) {
      currentIndex = (index + totalSlides) % totalSlides;

      slides.forEach((slide, i) => {
        if (i === currentIndex) {
          slide.classList.remove('opacity-0', 'z-0');
          slide.classList.add('opacity-100', 'z-10');
        } else {
          slide.classList.remove('opacity-100', 'z-10');
          slide.classList.add('opacity-0', 'z-0');
        }
      });

      dots.forEach((dot, i) => {
        if (i === currentIndex) {
          dot.classList.remove('w-2.5', 'bg-white/30');
          dot.classList.add('w-8', 'bg-[#bea380]');
        } else {
          dot.classList.remove('w-8', 'bg-[#bea380]');
          dot.classList.add('w-2.5', 'bg-white/30');
        }
      });
    }

    function startTimer() {
      stopTimer();
      timer = window.setInterval(() => {
        goToSlide(currentIndex + 1);
      }, 6500);
    }

    function stopTimer() {
      if (timer) clearInterval(timer);
    }

    dots.forEach((dot) => {
      dot.addEventListener('click', () => {
        const targetIndex = Number(dot.getAttribute('data-hero-dot'));
        if (!isNaN(targetIndex)) {
          goToSlide(targetIndex);
          startTimer();
        }
      });
    });

    startTimer();
  }

  setupHeroCarousel();
  document.addEventListener('astro:page-load', setupHeroCarousel);
</script>
