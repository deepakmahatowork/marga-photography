<style>
  /* Hero: animated line under title */
  @keyframes heroLineGrow {
    from { width: 0; opacity: 0; }
    to   { width: 3rem; opacity: 1; }
  }

  /* Transition overrides for hero images */
  .hero-slide {
    transition-duration: 1200ms;
  }

  /* Slide opacity transition time */
  .transition-opacity.duration-1200 {
    transition-duration: 1200ms;
  }
</style>

<script>
  // ─── Hero Carousel ────────────────────────────────────────────────────
  function setupHeroCarousel() {
    const slides   = document.querySelectorAll('.hero-slide');
    const dots     = document.querySelectorAll('.hero-dot');
    const counter  = document.getElementById('hero-film-counter');
    const locLabel = document.getElementById('hero-location-label');

    if (!slides.length) return;

    const locations = [
      'SAGARMATHA · 4,400M · KHUMBU',
      'ANNAPURNA RANGE · 8,091M',
      'DHORPATAN VALLEY · 3,900M',
    ];
    let currentIndex = 0;
    const total      = slides.length;
    let timer: number;

    function goToSlide(index: number) {
      currentIndex = ((index % total) + total) % total;

      slides.forEach((slide, i) => {
        const isActive = i === currentIndex;
        slide.classList.toggle('opacity-100', isActive);
        slide.classList.toggle('z-10', isActive);
        slide.classList.toggle('opacity-0', !isActive);
        slide.classList.toggle('z-0', !isActive);
      });

      dots.forEach((dot, i) => {
        const isActive = i === currentIndex;
        if (isActive) {
          (dot as HTMLElement).style.width = '2rem';
          (dot as HTMLElement).style.backgroundColor = 'var(--marga-gold)';
        } else {
          (dot as HTMLElement).style.width = '0.75rem';
          (dot as HTMLElement).style.backgroundColor = 'var(--hero-dot-inactive)';
        }
      });

      if (counter) {
        counter.textContent = `0${currentIndex + 1} / 0${total}`;
      }
      if (locLabel) {
        locLabel.textContent = locations[currentIndex] ?? '';
      }
    }

    function startTimer() {
      stopTimer();
      timer = window.setInterval(() => goToSlide(currentIndex + 1), 6500);
    }

    function stopTimer() {
      if (timer) clearInterval(timer);
    }

    dots.forEach((dot) => {
      dot.addEventListener('click', () => {
        const idx = Number(dot.getAttribute('data-hero-dot'));
        if (!isNaN(idx)) { goToSlide(idx); startTimer(); }
      });
    });

    startTimer();
  }

  // ─── Hero Parallax on Scroll ─────────────────────────────────────────
  function setupHeroParallax() {
    const heroSection = document.getElementById('hero-section');
    const heroImg     = document.getElementById('hero-primary-img') as HTMLImageElement | null;

    if (!heroSection || !heroImg) return;

    function onScroll() {
      if (!heroSection || !heroImg) return;
      const scrollY   = window.scrollY;
      const heroH     = heroSection.offsetHeight;
      if (scrollY > heroH) return;

      // Image moves at 30% of scroll speed (stays behind)
      const imgOffset = scrollY * 0.30;
      heroImg.style.transform = `translateY(${imgOffset}px)`;
    }

    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();
  }

  // ─── Scroll Reveal — IntersectionObserver ────────────────────────────
  function setupScrollReveal() {
    const elements = document.querySelectorAll('[data-reveal]');
    if (!elements.length) return;

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            const el    = entry.target as HTMLElement;
            const delay = el.dataset.revealDelay;
            if (delay) {
              el.style.transitionDelay = `${Number(delay) * 0.15}s`;
            }
            el.classList.add('revealed');
            observer.unobserve(el);
          }
        });
      },
      { threshold: 0.12, rootMargin: '0px 0px -40px 0px' }
    );

    elements.forEach((el) => observer.observe(el));
  }

  setupHeroCarousel();
  setupHeroParallax();
  setupScrollReveal();

  document.addEventListener('astro:page-load', () => {
    setupHeroCarousel();
    setupHeroParallax();
    setupScrollReveal();
  });
</script>
