---
import BaseLayout from '../layouts/BaseLayout.astro';
import PhotoGrid from '../components/photography/PhotoGrid.astro';
import Lightbox from '../components/photography/Lightbox.astro';
import ExpeditionCard from '../components/expeditions/ExpeditionCard.astro';
import InquiryForm from '../components/forms/InquiryForm.astro';
import { getCollection } from 'astro:content';

const allPhotos = await getCollection('photographs');
const featuredPhotos = allPhotos.filter((p) => p.data.featured);

const allExpeditions = await getCollection('expeditions');
const featuredExpeditions = allExpeditions.filter((e) => e.data.featured);

const homeJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Marga Photography',
  url: 'https://margaphotography.com',
  description: 'Specialist photography expeditions into the people, cultures, festivals, wildlife, and landscapes of Nepal.',
};
---

<BaseLayout
  title="Specialist Nepal Photography Expeditions & Visual Storytelling"
  description="Marga Photography creates bespoke, masterclass photography expeditions into the people, ancient rituals, living cultures, wildlife, and high Himalayan landscapes of Nepal."
  jsonLd={homeJsonLd}
>
  <!-- ══════════════════════════════════════════
       HERO — Cinematic full-bleed with editorial overlay
       ══════════════════════════════════════════ -->
  <section class="hero-section relative min-h-screen flex flex-col overflow-hidden">
    <!-- Background Image -->
    <div class="absolute inset-0 z-0">
      <img
        src="/images/hero_himalayan_valley_pasture.jpg"
        alt="High Himalayan pasture valley in Dhorpatan, Nepal"
        fetchpriority="high"
        decoding="async"
        class="w-full h-full object-cover"
      />
      <!-- Cinematic gradient — dark at bottom for text legibility -->
      <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent"></div>
    </div>

    <!-- Top Bar — Minimal branding -->
    <div class="relative z-10 flex items-center justify-between px-6 sm:px-10 pt-24 pb-4">
      <span class="text-[10px] uppercase tracking-[0.35em] text-white/50 font-mono">
        Est. 2014 · Kathmandu, Nepal
      </span>
      <span class="text-[10px] uppercase tracking-[0.35em] text-white/50 font-mono hidden sm:block">
        4–6 Photographers Per Expedition
      </span>
    </div>

    <!-- Main Hero Content — Bottom-aligned, editorial -->
    <div class="relative z-10 mt-auto px-6 sm:px-10 pb-16 sm:pb-20 max-w-6xl">
      <!-- Eyebrow -->
      <div class="flex items-center gap-3 mb-5">
        <span class="w-8 h-px bg-accent-himalaya"></span>
        <span class="text-[11px] uppercase tracking-[0.3em] text-accent-himalaya font-semibold">
          Photography Expeditions
        </span>
      </div>

      <!-- Headline -->
      <h1 class="font-editorial text-[clamp(2.5rem,7vw,5.5rem)] font-light text-white leading-[1.05] tracking-tight max-w-4xl">
        Into the Heart<br />
        of <em class="not-italic text-accent-himalaya">Nepal</em>
      </h1>

      <!-- Subhead -->
      <p class="mt-5 text-base sm:text-lg text-white/70 font-light leading-relaxed max-w-xl">
        Small-group visual expeditions into sacred rituals, wild tiger corridors, and the high Himalayan landscapes that no tour operator reaches.
      </p>

      <!-- CTAs -->
      <div class="mt-8 flex flex-col sm:flex-row items-stretch sm:items-center gap-4">
        <a
          href="/expeditions"
          class="group inline-flex items-center justify-center gap-2 px-8 py-4 bg-accent-himalaya text-white font-semibold text-xs uppercase tracking-[0.2em] rounded transition-all hover:brightness-110 shadow-lg shadow-accent-himalaya/20"
        >
          2026 Expeditions
          <span class="transition-transform group-hover:translate-x-1">→</span>
        </a>
        <a
          href="#portfolio"
          class="inline-flex items-center justify-center px-8 py-4 border border-white/25 text-white/90 font-medium text-xs uppercase tracking-[0.2em] rounded transition-all hover:border-white/60 hover:text-white"
        >
          View Portfolio
        </a>
      </div>

      <!-- Social Proof -->
      <div class="mt-10 flex items-center gap-6 text-[10px] uppercase tracking-[0.2em] text-white/40 font-mono">
        <span>12 Years Leading Expeditions</span>
        <span class="w-1 h-1 rounded-full bg-white/20"></span>
        <span>Nepal · Mustang · Khumbu · Terai</span>
      </div>
    </div>

    <!-- Scroll Indicator -->
    <div class="absolute bottom-6 left-1/2 -translate-x-1/2 z-10 flex flex-col items-center gap-2">
      <span class="text-[9px] uppercase tracking-[0.3em] text-white/30">Scroll</span>
      <div class="w-px h-8 bg-gradient-to-b from-white/30 to-transparent hero-scroll-line"></div>
    </div>
  </section>

  <!-- ══════════════════════════════════════════
       PORTFOLIO — Clean photo grid
       ══════════════════════════════════════════ -->
  <section id="portfolio" class="py-20 sm:py-28 bg-canvas-bg transition-colors duration-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-14">
        <h2 class="font-editorial text-3xl sm:text-4xl font-medium text-text-primary">
          Selected Work
        </h2>
        <p class="mt-3 text-sm text-text-secondary max-w-lg mx-auto">
          Documentary photography from across Nepal.
        </p>
      </div>

      <!-- Filter Tabs -->
      <div class="flex items-center justify-center gap-2 text-xs uppercase tracking-widest mb-12 overflow-x-auto no-scrollbar pb-2 -mx-4 px-4 sm:mx-0 sm:px-0 sm:flex-wrap">
        <a href="/explore/people" class="whitespace-nowrap px-4 py-2 rounded-full bg-canvas-surface hover:bg-accent-himalaya hover:text-white transition-colors border border-canvas-border hover:border-accent-himalaya text-text-secondary">
          People
        </a>
        <a href="/explore/culture" class="whitespace-nowrap px-4 py-2 rounded-full bg-canvas-surface hover:bg-accent-himalaya hover:text-white transition-colors border border-canvas-border hover:border-accent-himalaya text-text-secondary">
          Culture
        </a>
        <a href="/explore/festivals" class="whitespace-nowrap px-4 py-2 rounded-full bg-canvas-surface hover:bg-accent-himalaya hover:text-white transition-colors border border-canvas-border hover:border-accent-himalaya text-text-secondary">
          Festivals
        </a>
        <a href="/explore/wildlife" class="whitespace-nowrap px-4 py-2 rounded-full bg-canvas-surface hover:bg-accent-himalaya hover:text-white transition-colors border border-canvas-border hover:border-accent-himalaya text-text-secondary">
          Wildlife
        </a>
        <a href="/explore/landscapes" class="whitespace-nowrap px-4 py-2 rounded-full bg-canvas-surface hover:bg-accent-himalaya hover:text-white transition-colors border border-canvas-border hover:border-accent-himalaya text-text-secondary">
          Landscapes
        </a>
      </div>

      <PhotoGrid photos={featuredPhotos} />

      <div class="mt-10 text-center">
        <a
          href="/gallery"
          class="inline-flex items-center gap-2 text-xs uppercase tracking-[0.2em] font-semibold text-accent-himalaya hover:text-text-primary transition-colors"
        >
          View Full Gallery
          <span>→</span>
        </a>
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════════
       WHY MARGA — Minimalist two-column
       ══════════════════════════════════════════ -->
  <section class="py-20 sm:py-28 bg-canvas-surface border-y border-canvas-border transition-colors duration-200">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-12 md:gap-16 items-start">
        <div>
          <h2 class="font-editorial text-3xl sm:text-4xl font-medium text-text-primary leading-tight">
            Photography First.<br />
            <span class="italic text-text-muted font-light">Logistics as Craft.</span>
          </h2>
          <p class="text-text-secondary text-sm leading-relaxed mt-6">
            We built Marga Photography as a dedicated visual collective — every route, timing, and lodging is chosen strictly for light, vantage, and uninterrupted focus.
          </p>
          <p class="text-xs text-text-muted leading-relaxed mt-4">
            <strong class="text-text-primary">Powered by Marga Adventure</strong> — Nepal's premier expedition infrastructure.
          </p>
        </div>
        <div class="space-y-5">
          <div class="p-5 bg-canvas-elevated border border-canvas-border rounded-lg">
            <h3 class="text-sm font-medium text-text-primary">4–6 Photographers Per Group</h3>
            <p class="text-xs text-text-secondary mt-1.5 leading-relaxed">
              Intimate groups for unhurried shooting and genuine mentorship.
            </p>
          </div>
          <div class="p-5 bg-canvas-elevated border border-canvas-border rounded-lg">
            <h3 class="text-sm font-medium text-text-primary">Restricted Access Permits</h3>
            <p class="text-xs text-text-secondary mt-1.5 leading-relaxed">
              Upper Mustang, private foundries, hereditary elder permissions.
            </p>
          </div>
          <div class="p-5 bg-canvas-elevated border border-canvas-border rounded-lg">
            <h3 class="text-sm font-medium text-text-primary">Light-Dictated Pacing</h3>
            <p class="text-xs text-text-secondary mt-1.5 leading-relaxed">
              Blue hour shoots, midday editing sessions, sunset and astro.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════════
       EXPEDITIONS
       ══════════════════════════════════════════ -->
  <section class="py-20 sm:py-28 bg-canvas-bg transition-colors duration-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col md:flex-row md:items-end justify-between mb-14 gap-6">
        <div>
          <h2 class="font-editorial text-3xl sm:text-4xl font-medium text-text-primary">
            2026 Expeditions
          </h2>
          <p class="mt-2 text-sm text-text-secondary">
            Small-group departures across Nepal's most photogenic regions.
          </p>
        </div>
        <a
          href="/expeditions"
          class="text-xs uppercase tracking-[0.2em] font-semibold text-accent-himalaya hover:text-text-primary transition-colors"
        >
          All Expeditions →
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {featuredExpeditions.map((exp) => (
          <ExpeditionCard expedition={exp} />
        ))}
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════════
       INQUIRY
       ══════════════════════════════════════════ -->
  <section class="py-20 sm:py-28 bg-canvas-surface border-t border-canvas-border transition-colors duration-200" id="inquire">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <InquiryForm />
    </div>
  </section>

  <Lightbox />
</BaseLayout>

<style>
  /* Subtle scroll indicator animation */
  .hero-scroll-line {
    animation: scrollPulse 2s ease-in-out infinite;
  }
  @keyframes scrollPulse {
    0%, 100% { opacity: 0.3; transform: scaleY(1); }
    50% { opacity: 0.7; transform: scaleY(1.3); }
  }
</style>
