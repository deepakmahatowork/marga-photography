---
import BaseLayout from '../layouts/BaseLayout.astro';
import PhotoGrid from '../components/photography/PhotoGrid.astro';
import Lightbox from '../components/photography/Lightbox.astro';
import ExpeditionCard from '../components/expeditions/ExpeditionCard.astro';
import InquiryForm from '../components/forms/InquiryForm.astro';
import { getCollection } from 'astro:content';

const allPhotos = await getCollection('photographs');
const featuredPhotos = allPhotos.filter((p) => p.data.featured);

const allExpeditions = await getCollection('expeditions');
const featuredExpeditions = allExpeditions.filter((e) => e.data.featured);

const homeJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Marga Photography',
  url: 'https://margaphotography.com',
  description: 'Specialist photography expeditions into the people, cultures, festivals, wildlife, and landscapes of Nepal.',
};
---

<BaseLayout
  title="Specialist Nepal Photography Expeditions & Visual Storytelling"
  description="Marga Photography creates bespoke, masterclass photography expeditions into the people, ancient rituals, living cultures, wildlife, and high Himalayan landscapes of Nepal."
  jsonLd={homeJsonLd}
>
  <!-- 1. MINIMALIST HERO — Full-bleed photo, type over image -->
  <section class="relative min-h-[100vh] flex items-center justify-center overflow-hidden">
    <!-- Hero Background -->
    <div class="absolute inset-0 z-0">
      <img
        src="/images/hero_himalayan_valley_pasture.jpg"
        alt="High Himalayan pasture valley in Dhorpatan, Nepal"
        fetchpriority="high"
        decoding="async"
        class="w-full h-full object-cover object-center"
      />
      <div class="absolute inset-0 bg-black/40"></div>
    </div>

    <!-- Centered Minimal Type -->
    <div class="relative z-10 text-center px-6 max-w-3xl">
      <h1 class="font-editorial text-4xl sm:text-6xl lg:text-7xl font-light text-white leading-[1.1] tracking-tight">
        Nepal Through<br />
        <span class="italic">the Lens</span>
      </h1>
      <p class="mt-6 text-sm sm:text-base text-white/75 font-light leading-relaxed max-w-xl mx-auto">
        Small-group photography expeditions into the people, cultures, wildlife, and landscapes of the Himalaya.
      </p>
      <div class="mt-8 flex flex-col sm:flex-row items-center justify-center gap-4">
        <a
          href="/expeditions"
          class="px-8 py-3.5 bg-white text-black font-semibold text-xs uppercase tracking-[0.2em] rounded-full transition-all hover:bg-accent-himalaya hover:text-white shadow-lg"
        >
          View Expeditions
        </a>
        <a
          href="#portfolio"
          class="px-8 py-3.5 border border-white/30 text-white font-medium text-xs uppercase tracking-[0.2em] rounded-full transition-all hover:border-white hover:bg-white/10"
        >
          Portfolio
        </a>
      </div>
    </div>

    <!-- Subtle scroll indicator -->
    <div class="absolute bottom-8 left-1/2 -translate-x-1/2 z-10">
      <div class="w-px h-12 bg-gradient-to-b from-transparent to-white/50"></div>
    </div>
  </section>

  <!-- 2. PORTFOLIO — Clean photo grid -->
  <section id="portfolio" class="py-20 sm:py-28 bg-canvas-bg transition-colors duration-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-14">
        <h2 class="font-editorial text-3xl sm:text-4xl font-medium text-text-primary">
          Selected Work
        </h2>
        <p class="mt-3 text-sm text-text-secondary max-w-lg mx-auto">
          Documentary photography from across Nepal — people, culture, festivals, wildlife, and high Himalayan landscapes.
        </p>
      </div>

      <!-- Filter Tabs -->
      <div class="flex items-center justify-center gap-2 text-xs uppercase tracking-widest mb-12 overflow-x-auto no-scrollbar pb-2 -mx-4 px-4 sm:mx-0 sm:px-0 sm:flex-wrap">
        <a href="/explore/people" class="whitespace-nowrap px-4 py-2 rounded-full bg-canvas-surface hover:bg-accent-himalaya hover:text-white transition-colors border border-canvas-border hover:border-accent-himalaya text-text-secondary">
          People
        </a>
        <a href="/explore/culture" class="whitespace-nowrap px-4 py-2 rounded-full bg-canvas-surface hover:bg-accent-himalaya hover:text-white transition-colors border border-canvas-border hover:border-accent-himalaya text-text-secondary">
          Culture
        </a>
        <a href="/explore/festivals" class="whitespace-nowrap px-4 py-2 rounded-full bg-canvas-surface hover:bg-accent-himalaya hover:text-white transition-colors border border-canvas-border hover:border-accent-himalaya text-text-secondary">
          Festivals
        </a>
        <a href="/explore/wildlife" class="whitespace-nowrap px-4 py-2 rounded-full bg-canvas-surface hover:bg-accent-himalaya hover:text-white transition-colors border border-canvas-border hover:border-accent-himalaya text-text-secondary">
          Wildlife
        </a>
        <a href="/explore/landscapes" class="whitespace-nowrap px-4 py-2 rounded-full bg-canvas-surface hover:bg-accent-himalaya hover:text-white transition-colors border border-canvas-border hover:border-accent-himalaya text-text-secondary">
          Landscapes
        </a>
      </div>

      <PhotoGrid photos={featuredPhotos} />

      <div class="mt-10 text-center">
        <a
          href="/gallery"
          class="inline-flex items-center gap-2 text-xs uppercase tracking-[0.2em] font-semibold text-accent-himalaya hover:text-text-primary transition-colors"
        >
          View Full Gallery
          <span>→</span>
        </a>
      </div>
    </div>
  </section>

  <!-- 3. WHY MARGA — Simple two-column -->
  <section class="py-20 sm:py-28 bg-canvas-surface border-y border-canvas-border transition-colors duration-200">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-12 md:gap-16 items-start">
        <div>
          <h2 class="font-editorial text-3xl sm:text-4xl font-medium text-text-primary leading-tight">
            Photography First.<br />
            <span class="italic text-text-muted font-light">Logistics as Craft.</span>
          </h2>
          <p class="text-text-secondary text-sm leading-relaxed mt-6">
            Most tour operators tack on a photography tag to regular trekking packages. We built Marga Photography as a dedicated visual collective — every route, timing, and lodging is chosen strictly for light, vantage, and uninterrupted focus.
          </p>
          <p class="text-xs text-text-muted leading-relaxed mt-4">
            <strong class="text-text-primary">Powered by Marga Adventure</strong> — Nepal's premier expedition infrastructure: 4WD rescue vehicles, satellite comms, helicopter networks, and restricted area permits.
          </p>
        </div>
        <div class="space-y-6">
          <div class="p-5 bg-canvas-elevated border border-canvas-border rounded-lg">
            <h3 class="text-sm font-medium text-text-primary">4–6 Photographers Per Group</h3>
            <p class="text-xs text-text-secondary mt-1.5 leading-relaxed">
              Intimate groups for unhurried shooting and genuine personal mentorship.
            </p>
          </div>
          <div class="p-5 bg-canvas-elevated border border-canvas-border rounded-lg">
            <h3 class="text-sm font-medium text-text-primary">Restricted Access Permits</h3>
            <p class="text-xs text-text-secondary mt-1.5 leading-relaxed">
              Upper Mustang, private bronze foundries, hereditary elder permissions — our indigenous network opens doors.
            </p>
          </div>
          <div class="p-5 bg-canvas-elevated border border-canvas-border rounded-lg">
            <h3 class="text-sm font-medium text-text-primary">Light-Dictated Pacing</h3>
            <p class="text-xs text-text-secondary mt-1.5 leading-relaxed">
              Shoot at blue hour, rest during midday glare for editing sessions, resume for sunset and astrophotography.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 4. EXPEDITIONS -->
  <section class="py-20 sm:py-28 bg-canvas-bg transition-colors duration-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col md:flex-row md:items-end justify-between mb-14 gap-6">
        <div>
          <h2 class="font-editorial text-3xl sm:text-4xl font-medium text-text-primary">
            2026 Expeditions
          </h2>
          <p class="mt-2 text-sm text-text-secondary">
            Small-group departures across Nepal's most photogenic regions.
          </p>
        </div>
        <a
          href="/expeditions"
          class="text-xs uppercase tracking-[0.2em] font-semibold text-accent-himalaya hover:text-text-primary transition-colors"
        >
          All Expeditions →
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {featuredExpeditions.map((exp) => (
          <ExpeditionCard expedition={exp} />
        ))}
      </div>
    </div>
  </section>

  <!-- 5. INQUIRY -->
  <section class="py-20 sm:py-28 bg-canvas-surface border-t border-canvas-border transition-colors duration-200" id="inquire">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <InquiryForm />
    </div>
  </section>

  <Lightbox />
</BaseLayout>
